<UserControl x:Class="XIAOFUTools.Tools.LayoutTools.LayoutTextReplace.LayoutTextReplaceDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XIAOFUTools.Tools.LayoutTools.LayoutTextReplace"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主标签页控件 -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource PageTabControlStyle}"
                    ItemContainerStyle="{StaticResource PageTabItemStyle}">
            <!-- 查找标签页 -->
            <TabItem Header="查找">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 查找内容 -->
                    <GroupBox Grid.Row="0" Header="查找条件" Style="{StaticResource GroupBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="查找内容:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}" Height="24"/>
                        </Grid>
                    </GroupBox>

                    <!-- 布局元素列表（查找范围） -->
                    <GroupBox Grid.Row="1" Header="查找范围（布局列表）" Style="{StaticResource GroupBoxStyle}" MaxHeight="150">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                <Button Content="全选" Command="{Binding SelectAllLayoutsCommand}"
                                        Style="{StaticResource DefaultButtonStyle}" Width="50" Height="26" Margin="0,0,4,0"/>
                                <Button Content="反选" Command="{Binding InvertLayoutSelectionCommand}"
                                        Style="{StaticResource DefaultButtonStyle}" Width="50" Height="26" Margin="0,0,4,0"/>
                                <Button Content="⟲" Width="26" Height="26"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Command="{Binding RefreshLayoutsCommand}"
                                        ToolTip="刷新布局列表" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                            <Border Grid.Row="1" BorderBrush="#CDCDCD" BorderThickness="1" MaxHeight="90">
                                <ListBox ItemsSource="{Binding Layouts}" Background="White">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                      Style="{StaticResource CheckBoxStyle}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- 查找结果 -->
                    <GroupBox Grid.Row="2" Header="查找结果" Style="{StaticResource GroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#CDCDCD" BorderThickness="1">
                                <DataGrid ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False"
                                          SelectedItem="{Binding SelectedSearchResult}"
                                          IsReadOnly="True" CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          Background="White">
                                    <DataGrid.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding NavigateToElementCommand}"/>
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="布局名称" Binding="{Binding LayoutName}" Width="100"/>
                                        <DataGridTextColumn Header="元素名称" Binding="{Binding ElementName}" Width="100"/>
                                        <DataGridTemplateColumn Header="元素内容" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <local:HighlightTextBlock 
                                                        SourceText="{Binding DisplayText}" 
                                                        HighlightText="{Binding SearchKeyword}"
                                                        HighlightBrush="#FFFFCC00"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding FullText}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Content="查找全部" Command="{Binding SearchAllCommand}"
                                        Style="{StaticResource ExecuteButtonStyle}" Width="80" Height="26"/>
                                <TextBlock Text="{Binding SearchResultCount, StringFormat='共找到 {0} 个结果'}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 替换标签页 -->
            <TabItem Header="替换">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 查找替换条件 -->
                    <GroupBox Grid.Row="0" Header="查找替换条件" Style="{StaticResource GroupBoxStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="查找内容:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ReplaceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Height="24"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="替换为:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Height="24"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 布局元素列表（替换范围） -->
                    <GroupBox Grid.Row="1" Header="替换范围（布局列表）" Style="{StaticResource GroupBoxStyle}" MaxHeight="150">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                <Button Content="全选" Command="{Binding SelectAllLayoutsCommand}"
                                        Style="{StaticResource DefaultButtonStyle}" Width="50" Height="26" Margin="0,0,4,0"/>
                                <Button Content="反选" Command="{Binding InvertLayoutSelectionCommand}"
                                        Style="{StaticResource DefaultButtonStyle}" Width="50" Height="26" Margin="0,0,4,0"/>
                                <Button Content="⟲" Width="26" Height="26"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Command="{Binding RefreshLayoutsCommand}"
                                        ToolTip="刷新布局列表" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                            <Border Grid.Row="1" BorderBrush="#CDCDCD" BorderThickness="1" MaxHeight="90">
                                <ListBox ItemsSource="{Binding Layouts}" Background="White">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                      Style="{StaticResource CheckBoxStyle}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- 替换结果 -->
                    <GroupBox Grid.Row="2" Header="查找结果" Style="{StaticResource GroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#CDCDCD" BorderThickness="1">
                                <DataGrid ItemsSource="{Binding ReplaceResults}" AutoGenerateColumns="False"
                                          SelectedItem="{Binding SelectedReplaceResult}"
                                          IsReadOnly="True" CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          SelectionMode="Extended"
                                          Background="White">
                                    <DataGrid.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding NavigateToReplaceElementCommand}"/>
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                                        <DataGridTextColumn Header="布局名称" Binding="{Binding LayoutName}" Width="90"/>
                                        <DataGridTextColumn Header="元素名称" Binding="{Binding ElementName}" Width="90"/>
                                        <DataGridTemplateColumn Header="元素内容" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <local:HighlightTextBlock 
                                                        SourceText="{Binding DisplayText}" 
                                                        HighlightText="{Binding SearchKeyword}"
                                                        HighlightBrush="#FFFFCC00"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding FullText}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="查找全部" Command="{Binding SearchForReplaceCommand}"
                                            Style="{StaticResource DefaultButtonStyle}" Width="70" Height="26" Margin="0,0,4,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ReplaceResultCount, StringFormat='共 {0} 个结果'}"
                                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="替换所选" Command="{Binding ReplaceSelectedCommand}"
                                            Style="{StaticResource DefaultButtonStyle}" Width="70" Height="26" Margin="0,0,4,0"/>
                                    <Button Content="全部替换" Command="{Binding ReplaceAllCommand}"
                                            Style="{StaticResource ExecuteButtonStyle}" Width="70" Height="26"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部按钮区域 -->
        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="0,10,0,0">
            <Grid>
                <Button Content="?" Style="{StaticResource HelpButtonStyle}"
                        Command="{Binding ShowHelpCommand}"
                        HorizontalAlignment="Left" ToolTip="显示帮助信息"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#666666" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
