<UserControl x:Class="XIAOFUTools.Tools.FeatureToTxt.FeatureToTxtDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:local="clr-namespace:XIAOFUTools.Tools.FeatureToTxt"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 布尔值转可见性转换器 -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <!-- 字段名称转颜色转换器 -->
            <local:FieldNameToColorConverter x:Key="FieldNameToColorConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部固定区域：基本设置 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8,10,8">
            <!-- 要素图层选择 -->
            <GroupBox Header="基本设置" Style="{StaticResource GroupBoxStyle}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 要素图层 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="要素图层(面):"
                             Style="{StaticResource FormLabelStyle}" Margin="0,0,6,4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,3,4"
                            ItemsSource="{Binding PolygonLayers}"
                            SelectedItem="{Binding SelectedPolygonLayer}"
                            DisplayMemberPath="Name"
                            Style="{StaticResource ComboBoxStyle}"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="刷新" Margin="0,0,0,4"
                          Command="{Binding RefreshLayersCommand}"
                          Style="{StaticResource DefaultButtonStyle}"/>

                    <!-- 输出文件夹 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="输出文件夹:"
                             Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,3,0"
                           Text="{Binding OutputPath}"
                           Style="{StaticResource TextBoxStyle}"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseOutputPathCommand}"
                          Style="{StaticResource DefaultButtonStyle}"/>

                    <!-- 使用所选记录 滑动开关（有选择时显示） -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectionInLayer}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UseSelection}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ToggleButton x:Name="UseSelectionSwitch"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding UseSelection, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource InfoTextBlockStyle}">
                            <Run Text="使用所选记录："/>
                            <Run Text="{Binding SelectedCount}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Border>

        <!-- 中间滚动区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6,8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 配置设置 -->
                    <RowDefinition Height="Auto"/>  <!-- 进度条 -->
                    <RowDefinition Height="*"/>     <!-- 日志窗口 -->
                    <RowDefinition Height="Auto"/>  <!-- 状态消息 -->
                </Grid.RowDefinitions>

                <!-- 配置设置（合并：头部配置 + 字段配置 + 选项设置） -->
                <GroupBox Grid.Row="0" Header="配置设置" Margin="0,0,0,6" Style="{StaticResource GroupBoxStyle}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 1. 头部信息配置 -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="头部配置:" VerticalAlignment="Center" 
                                      Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" 
                                     ItemsSource="{Binding HeaderConfigs}"
                                     SelectedItem="{Binding SelectedHeaderConfig, Mode=TwoWay}"
                                     Style="{StaticResource ComboBoxStyle}"
                                     Height="26"
                                     Margin="0,0,4,0"
                                     ToolTip="选择要使用的头部信息配置">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" Content="管理" 
                                   Command="{Binding OpenHeaderConfigCommand}" 
                                   Style="{StaticResource DefaultButtonStyle}" 
                                   MinWidth="50" Height="26"
                                   ToolTip="打开头部信息配置管理窗口"/>
                        </Grid>
                        
                        <Separator Grid.Row="1" Margin="0,0,0,6" Background="#E0E0E0"/>
                        
                        <!-- 2. 输出字段配置 -->
                        <Grid Grid.Row="2" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Content="配置字段" 
                                    Command="{Binding OpenFieldConfigCommand}" 
                                    Style="{StaticResource DefaultButtonStyle}" 
                                    MinWidth="75" Height="26"
                                    Margin="0,0,6,0"
                                    ToolTip="打开字段配置窗口"/>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="已配置" Foreground="#666666" FontSize="11" Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding OutputFieldsCount, Mode=OneWay}" 
                                          FontWeight="Bold" FontSize="14" Foreground="#2196F3"/>
                                <TextBlock Text="个字段" Foreground="#666666" FontSize="11" Margin="3,0,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="重置" Command="{Binding ResetDefaultFieldsCommand}" 
                                        Style="{StaticResource DefaultButtonStyle}" 
                                        MinWidth="50" Height="26" Margin="0,0,4,0"/>
                                <Button Content="清空" Command="{Binding ClearAllOutputFieldsCommand}" 
                                        Style="{StaticResource CancelButtonStyle}"
                                        MinWidth="50" Height="26"/>
                            </StackPanel>
                        </Grid>
                        
                        <Separator Grid.Row="3" Margin="0,0,0,6" Background="#E0E0E0"/>
                        
                        <!-- 3. 选项设置 -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 左列：输出选项 -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="输出选项" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Foreground="#555"/>
                                <CheckBox Content="输出闭合点" Margin="0,0,0,2" IsChecked="{Binding OutputClosingPoint}" Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox Content="内环1起编" Margin="0,0,0,2" IsChecked="{Binding InnerRingStartFromOne}" Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox Content="闭合点续编" Margin="0,0,0,2" IsChecked="{Binding ClosingPointContinueNumbering}" Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox Content="分块导出" Margin="0,0,0,2" IsChecked="{Binding ExportSeparately}" Style="{StaticResource CheckBoxStyle}"/>
                                <CheckBox Content="按字段分组" Margin="0,0,0,2" IsChecked="{Binding GroupByField}" Style="{StaticResource CheckBoxStyle}" ToolTip="按指定字段值分组导出，每组生成独立文件"/>
                                <CheckBox Content="XY互换" Margin="0,0,0,0" IsChecked="{Binding SwapXY}" Style="{StaticResource CheckBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- 右列：格式设置 + 分组字段选择 -->
                            <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                <TextBlock Text="格式设置" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Foreground="#555"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="前缀:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Prefix}" Style="{StaticResource TextBoxStyle}" Height="24" Margin="0,0,0,4"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="小数位:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DecimalPlaces}" Style="{StaticResource TextBoxStyle}" Height="24" Margin="0,0,0,4"/>
                                    
                                    <!-- 分组字段选择（仅在启用分组时显示） -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="分组字段:" 
                                              Style="{StaticResource FormLabelStyle}" 
                                              Margin="0,0,6,0"
                                              Visibility="{Binding GroupByField, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Grid Grid.Row="2" Grid.Column="1" 
                                          Visibility="{Binding GroupByField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ComboBox ItemsSource="{Binding GroupableFields}"
                                                 SelectedItem="{Binding GroupByFieldName, Mode=TwoWay}"
                                                 Style="{StaticResource ComboBoxStyle}"
                                                 Height="24"
                                                 ToolTip="选择用于分组的字段，文件名将使用该字段的值">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <!-- 无数据提示 -->
                                        <TextBlock Text="(请先选择图层)" 
                                                  Foreground="#999" 
                                                  FontSize="11"
                                                  IsHitTestVisible="False"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GroupableFields.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- 进度条 -->
                <ProgressBar Grid.Row="1" Margin="0,0,0,6"
                           Value="{Binding Progress}"
                           Minimum="0" Maximum="100"
                           IsIndeterminate="{Binding IsProgressIndeterminate}"
                           Style="{StaticResource ProgressBarStyle}"/>

                <!-- 日志窗口 -->
                <Border Grid.Row="2" BorderBrush="#CDCDCD" BorderThickness="1" Margin="0,0,0,6" MinHeight="100" MaxHeight="150">
                    <TextBox Text="{Binding LogContent, Mode=OneWay}"
                           Style="{StaticResource LogTextBoxStyle}"/>
                </Border>

                <!-- 状态消息 -->
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                         Style="{StaticResource StatusTextStyle}"
                         TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,0"/>
            </Grid>
        </ScrollViewer>

        <!-- 底部固定区域：按钮区域 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0"
               BorderThickness="0,1,0,0"
               Padding="8,6,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 帮助按钮（左下角） -->
                <Button Grid.Column="0" Content="?" VerticalAlignment="Center" Margin="0,0,8,0"
                        Command="{Binding ShowHelpCommand}"
                        Style="{StaticResource HelpButtonStyle}"
                        ToolTip="显示帮助信息"/>

                <!-- 文本格式选择 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="文本格式:" Style="{StaticResource FormLabelStyle}" Margin="0,0,4,0"/>
                    <ComboBox Width="90" ItemsSource="{Binding TextFormats}"
                            SelectedItem="{Binding SelectedTextFormat}"
                            Style="{StaticResource ComboBoxStyle}"
                            ToolTip="选择输出文件的文本编码格式"/>
                </StackPanel>

                <!-- 按钮组 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 只在处理时显示停止按钮 -->
                    <Button Content="停止" Command="{Binding CancelCommand}" Margin="0,0,6,0"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                            IsEnabled="{Binding IsProcessing}"
                            Style="{StaticResource CancelButtonStyle}"/>
                    <Button Content="生成TXT" Command="{Binding RunCommand}"
                            IsEnabled="{Binding CanProcess}"
                            Style="{StaticResource ExecuteButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
