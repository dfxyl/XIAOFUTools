<Window x:Class="XIAOFUTools.Tools.FeatureToTxt.HeaderConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x5934;&#x90E8;&#x4FE1;&#x606F;&#x914D;&#x7F6E;&#x7BA1;&#x7406;"
        Height="550"
        Width="850"
        MinHeight="450"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="White">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Background="#F9F9F9"
                    BorderBrush="#CDCDCD"
                    BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,10"
                               FontSize="14"
                               FontWeight="Bold"
                               Text="&#x914D;&#x7F6E;&#x5217;&#x8868;" />

                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Background="White"
                            BorderBrush="#CDCDCD"
                            BorderThickness="1">
                        <ListBox x:Name="ConfigListBox"
                                 Padding="4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 DisplayMemberPath="Name"
                                 ItemsSource="{Binding Configs}"
                                 SelectedItem="{Binding SelectedConfig, Mode=TwoWay}" />
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Vertical">
                        <Button Height="34"
                                Margin="0,0,0,8"
                                Command="{Binding AddConfigCommand}"
                                Content="&#x65B0;&#x589E;&#x914D;&#x7F6E;"
                                FontSize="12"
                                Style="{StaticResource DefaultButtonStyle}" />
                        <Button Height="34"
                                Command="{Binding DeleteConfigCommand}"
                                Content="&#x5220;&#x9664;&#x914D;&#x7F6E;"
                                FontSize="12"
                                Style="{StaticResource CancelButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#CDCDCD"
                    BorderThickness="1">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,14"
                               FontSize="14"
                               FontWeight="Bold"
                               Text="&#x914D;&#x7F6E;&#x8BE6;&#x60C5;" />

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource FormLabelStyle}"
                                   Text="&#x914D;&#x7F6E;&#x540D;&#x79F0;:" />
                        <TextBox Grid.Column="1"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding SelectedConfig.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="&#x5934;&#x90E8;&#x4FE1;&#x606F;&#x5185;&#x5BB9;" />
                            <TextBlock FontSize="11"
                                       Foreground="#666666"
                                       TextWrapping="Wrap">&#x76F4;&#x63A5;&#x7C98;&#x8D34;&#x5B8C;&#x6574;&#x7684;&#x5934;&#x90E8;&#x4FE1;&#x606F;&#x6587;&#x672C;&#xFF0C;&#x5305;&#x542B; [&#x5C5E;&#x6027;&#x63CF;&#x8FF0;] &#x548C; [&#x5730;&#x5757;&#x5750;&#x6807;] &#x7B49;&#x6807;&#x8BB0;&#x3002;</TextBlock>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#FAFAFA"
                                BorderBrush="#CDCDCD"
                                BorderThickness="1">
                            <TextBox Padding="10"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     HorizontalScrollBarVisibility="Auto"
                                     Style="{StaticResource MultiLineTextBoxStyle}"
                                     Text="{Binding SelectedConfig.HeaderText, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="NoWrap"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    Style="{StaticResource ExecuteButtonStyle}">&#x4FDD;&#x5B58;&#x5E76;&#x5E94;&#x7528;</Button>
            <Button Width="80"
                    Height="32"
                    Click="CancelButton_Click"
                    Style="{StaticResource CancelButtonStyle}">&#x53D6;&#x6D88;</Button>
        </StackPanel>
    </Grid>
</Window>
