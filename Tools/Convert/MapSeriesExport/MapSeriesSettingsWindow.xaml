<Window x:Class="XIAOFUTools.Tools.Output.MapSeriesExport.MapSeriesSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="驱动制图设置" Height="720" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CategoryHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#2D5A8A"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 2列分类布局 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ 第1列：坐标表设置 ═══════════ -->
            <Border Grid.Column="0" BorderBrush="#C5D9F1" BorderThickness="1" CornerRadius="6" Background="#FAFCFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📋 坐标表设置" Style="{StaticResource CategoryHeader}"/>
                            <Button Grid.Column="1" Content="生成模板" Height="22" Width="60"
                                    Style="{StaticResource DefaultButtonStyle}" FontSize="10"
                                    Click="CreateTemplates_Click" ToolTip="生成 XF_TX、XF_WB 模板"/>
                        </Grid>
                        
                        <CheckBox x:Name="EnableCoordinateTableCheckBox" 
                                  Content="启用坐标表生成" 
                                  Style="{StaticResource CheckBoxStyle}" 
                                  Margin="0,0,0,6"/>
                        
                        <TextBlock Text="表格标题:" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TitleTextBox" 
                                 Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11" Margin="0,0,0,6"
                                 ToolTip="支持字段占位符 [DKMC]、[DKBH] 等"/>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="点号前缀:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="PrefixTextBox" Text="J" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="小数位:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="DecimalTextBox" Text="3" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="每列行数:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="RowsPerColumnTextBox" Text="20" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="点号宽" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="PointColWidthTextBox" Text="10" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="坐标宽" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="XYColWidthTextBox" Text="22" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="边长宽" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="EdgeColWidthTextBox" Text="12" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="行高" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="RowHeightTextBox" Text="5.5" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="GenerateEdgeCheckBox" Content="边长" 
                                      Style="{StaticResource CheckBoxStyle}" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,8,4"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="放置位置:" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="PlacementCornerComboBox" Style="{StaticResource ComboBoxStyle}" Height="24" FontSize="11">
                                    <ComboBoxItem Content="左下角" IsSelected="True"/>
                                    <ComboBoxItem Content="右下角"/>
                                    <ComboBoxItem Content="左上角"/>
                                    <ComboBoxItem Content="右上角"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="偏移(mm):" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="CornerOffsetTextBox" Text="2" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <RadioButton x:Name="MapFramePositionRadio" Content="地图框" 
                                         GroupName="PositionMode" IsChecked="True" 
                                         Checked="PositionModeChanged" Margin="0,0,12,0" FontSize="11"/>
                            <RadioButton x:Name="AnchorPositionRadio" Content="锚点" 
                                         GroupName="PositionMode" Checked="PositionModeChanged" FontSize="11"/>
                        </StackPanel>
                        
                        <Grid x:Name="MapFramePanel" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MapFrameComboBox" Style="{StaticResource ComboBoxStyle}" Height="24" FontSize="11"/>
                            <Button Grid.Column="1" Content="刷新" Height="24" Width="40" Margin="4,0,0,0"
                                    Style="{StaticResource DefaultButtonStyle}" FontSize="10"
                                    Click="RefreshMapFrames_Click" ToolTip="刷新地图框列表"/>
                        </Grid>
                        
                        <Grid x:Name="AnchorPanel" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AnchorNameTextBox" Text="XF_MD" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            <Button Grid.Column="1" Content="创建" Height="24" Width="40" Margin="4,0,0,0"
                                    Style="{StaticResource DefaultButtonStyle}" FontSize="10"
                                    Click="CreateAnchor_Click" ToolTip="创建锚点"/>
                        </Grid>
                        
                        <Separator Margin="0,4,0,8" Background="#C5D9F1"/>
                        
                        <TextBlock Text="面积行" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="生成模式:" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="AreaModeComboBox" Style="{StaticResource ComboBoxStyle}" Height="24" FontSize="11"
                                          SelectionChanged="AreaModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="不生成"/>
                                    <ComboBoxItem Content="自动生成" IsSelected="True"/>
                                    <ComboBoxItem Content="自定义"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="面积单位:" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="AreaUnitComboBox" Style="{StaticResource ComboBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid x:Name="AutoAreaPanel" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="面积小数:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="AreaDecimalTextBox" Text="2" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="亩位数:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="MuDecimalTextBox" Text="4" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="等待(ms):" FontSize="10" Margin="0,0,0,2" ToolTip="生成后等待渲染时间"/>
                                <TextBox x:Name="ExportDelayTextBox" Text="1000" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid x:Name="CustomAreaPanel" Margin="0,0,0,6" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="自定义文本:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="CustomAreaTextBox" Text="S=[Shape_Area] 平方米" 
                                         Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"
                                         ToolTip="支持 [Shape_Area]、[DKMC] 等字段占位符"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══════════ 第2列：界址点与点号设置 ═══════════ -->
            <Border Grid.Column="2" BorderBrush="#D4E5C9" BorderThickness="1" CornerRadius="6" Background="#FBFDF9">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- 界址点部分 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📍 界址点设置" Style="{StaticResource CategoryHeader}" Foreground="#4A7C3F"/>
                            <Button Grid.Column="1" Content="生成模板" Height="22" Width="60"
                                    Style="{StaticResource DefaultButtonStyle}" FontSize="10"
                                    Click="CreatePointTemplate_Click" ToolTip="生成 XF_JZD 模板"/>
                        </Grid>
                        
                        <CheckBox x:Name="EnableBoundaryPointsCheckBox" 
                                  Content="在地图上生成界址点" 
                                  Style="{StaticResource CheckBoxStyle}" 
                                  Margin="0,0,0,6"/>
                        
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="点符号大小:" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="BoundaryPointSizeTextBox" Text="8" 
                                     Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"
                                     ToolTip="界址点符号大小（点）"/>
                        </StackPanel>
                        
                        <Separator Margin="0,0,0,10" Background="#D4E5C9"/>
                        
                        <!-- 点号部分 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔢 点号设置" Style="{StaticResource CategoryHeader}" Foreground="#C25A3C"/>
                            <Button Grid.Column="1" Content="生成模板" Height="22" Width="60"
                                    Style="{StaticResource DefaultButtonStyle}" FontSize="10"
                                    Click="CreateLabelTemplate_Click" ToolTip="生成 XF_DH 模板"/>
                        </Grid>
                        
                        <CheckBox x:Name="EnablePointLabelsCheckBox" 
                                  Content="在界址点外侧生成点号" 
                                  Style="{StaticResource CheckBoxStyle}" 
                                  Margin="0,0,0,6"/>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="前缀:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="PointLabelPrefixTextBox" Text="J" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="后缀:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="PointLabelSuffixTextBox" Text="" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="距离(mm):" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="PointLabelDistanceTextBox" Text="3" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"
                                         ToolTip="点号距离界址点的距离"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="字体大小:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="PointLabelSizeTextBox" Text="12" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="压盖处理:" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="PointLabelOverlapComboBox" Style="{StaticResource ComboBoxStyle}" Height="24" FontSize="11">
                                    <ComboBoxItem Content="压盖隐藏" IsSelected="True"/>
                                    <ComboBoxItem Content="压盖避让"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        
                        <Separator Margin="0,8,0,10" Background="#D4E5C9"/>
                        
                        <!-- 边长标注部分 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📏 边长标注设置" Style="{StaticResource CategoryHeader}" Foreground="#6B4E9B"/>
                            <Button Grid.Column="1" Content="生成模板" Height="22" Width="60"
                                    Style="{StaticResource DefaultButtonStyle}" FontSize="10"
                                    Click="CreateEdgeLabelTemplate_Click" ToolTip="生成 XF_BC 模板"/>
                        </Grid>
                        
                        <CheckBox x:Name="EnableEdgeLabelsCheckBox" 
                                  Content="在边中点生成边长标注" 
                                  Style="{StaticResource CheckBoxStyle}" 
                                  Margin="0,0,0,6"/>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="前缀:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="EdgeLabelPrefixTextBox" Text="" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="后缀:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="EdgeLabelSuffixTextBox" Text="" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="小数位:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="EdgeLabelDecimalTextBox" Text="2" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="EdgeLabelPadZerosCheckBox" Grid.Column="6" 
                                      Content="补零" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                      Style="{StaticResource CheckBoxStyle}" FontSize="10"
                                      ToolTip="勾选后小数补零到指定位数（如2.3→2.30）"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="距离(mm):" FontSize="10" Margin="0,0,0,2" ToolTip="边长距离边的距离"/>
                                <TextBox x:Name="EdgeLabelDistanceTextBox" Text="2" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="字体大小:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="EdgeLabelSizeTextBox" Text="10" Style="{StaticResource TextBoxStyle}" Height="24" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="压盖处理:" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="EdgeLabelOverlapComboBox" Style="{StaticResource ComboBoxStyle}" Height="24" FontSize="11">
                                    <ComboBoxItem Content="压盖隐藏" IsSelected="True"/>
                                    <ComboBoxItem Content="压盖避让"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        
                        <Separator Margin="0,8,0,10" Background="#D4E5C9"/>
                        
                        <TextBlock Text="说明" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#666666"/>
                        <TextBlock Text="• 界址点/点号/边长在图形图层生成" FontSize="10" Foreground="#888888" Margin="0,0,0,2"/>
                        <TextBlock Text="• 点号沿角平分线外侧（8方向避让）" FontSize="10" Foreground="#888888" Margin="0,0,0,2"/>
                        <TextBlock Text="• 边长在边的中点外侧生成" FontSize="10" Foreground="#888888" Margin="0,0,0,2"/>
                        <TextBlock Text="• 点号与边长参与联合压盖检测" FontSize="10" Foreground="#888888"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="80" Height="28" 
                    Style="{StaticResource ExecuteButtonStyle}"
                    Click="OkButton_Click"/>
            <Button Content="取消" Width="80" Height="28" Margin="8,0,0,0"
                    Style="{StaticResource CancelButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
