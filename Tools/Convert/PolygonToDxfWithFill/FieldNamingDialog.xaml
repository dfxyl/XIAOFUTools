<Window x:Class="XIAOFUTools.Tools.PolygonToDxfWithFill.FieldNamingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命名规则" Height="380" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 命名模式选择 -->
        <GroupBox Header="命名模式" Margin="0,0,0,6">
            <StackPanel Margin="8,4,8,4">
                <RadioButton x:Name="rdoUnique" Content="按符号唯一值（默认）" GroupName="NamingMode" Checked="UniqueValueMode_Checked"/>
                <RadioButton x:Name="rdoField" Content="按字段组合" GroupName="NamingMode" Checked="FieldMode_Checked"/>
            </StackPanel>
        </GroupBox>

        <!-- 字段列表与拖拽排序 -->
        <GroupBox Grid.Row="1" Header="字段（拖拽排序）" Margin="0,0,0,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="8,4,8,0" Foreground="#666" Text="勾选纳入命名的字段，拖动改变顺序"/>
                <ListBox x:Name="FieldsListBox"
                         Margin="6"
                         ItemsSource="{Binding Fields}"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="FieldsListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="FieldsListBox_PreviewMouseMove"
                         Drop="FieldsListBox_Drop"
                         IsEnabled="{Binding UseFieldNaming}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding FullDisplayName}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- 底部：连接符 + 按钮 -->
        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="连接符:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="120" Text="{Binding Separator, Mode=TwoWay}" IsEnabled="{Binding UseFieldNaming}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="确定" Width="80" Margin="0,0,6,0" IsDefault="True" Click="OkButton_Click"
                        Style="{StaticResource DefaultButtonStyle}"/>
                <Button Content="取消" Width="80" IsCancel="True" Style="{StaticResource CancelButtonStyle}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
