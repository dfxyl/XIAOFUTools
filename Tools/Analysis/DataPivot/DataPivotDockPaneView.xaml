<UserControl x:Class="XIAOFUTools.Tools.DataPivot.DataPivotDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="430"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="输入数据" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="输入表:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding InputDatasets}"
                          SelectedItem="{Binding SelectedInputDataset}"
                          DisplayMemberPath="DisplayName"/>
                <Button Grid.Column="2"
                        Width="22"
                        Height="22"
                        Margin="5,0,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding RefreshDatasetsCommand}"
                        ToolTip="刷新图层/表列表"
                        VerticalAlignment="Center">
                    <TextBlock Text="⟲" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="透视参数" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="区域字段:" VerticalAlignment="Top" Margin="0,0,10,0"/>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#ADADAD" BorderThickness="1" CornerRadius="4" MaxHeight="110" Margin="0,0,0,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RegionFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="5,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="透视字段:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding PivotFields}"
                          SelectedItem="{Binding SelectedPivotField}"
                          DisplayMemberPath="DisplayText"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="数值字段:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding ValueFields}"
                          SelectedItem="{Binding SelectedValueField}"
                          DisplayMemberPath="DisplayText"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="汇总方式:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Row="3" Grid.Column="1"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding AggregationTypes}"
                          SelectedItem="{Binding SelectedAggregationType}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="输出设置" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="输出GDB:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                         Style="{StaticResource TextBoxStyle}"
                         Text="{Binding OutputGdbPath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="浏览" Width="60" Margin="8,0,0,8"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding BrowseOutputGdbCommand}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="输出表名:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                         Style="{StaticResource TextBoxStyle}"
                         Text="{Binding OutputTableName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="输出路径:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{Binding OutputTablePath}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </GroupBox>

        <ProgressBar Grid.Row="3"
                     Style="{StaticResource ProgressBarStyle}"
                     Value="{Binding Progress}"
                     Height="6"
                     Margin="0,0,0,8"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"/>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <Border Grid.Row="5" BorderBrush="#CDCDCD" BorderThickness="1" Margin="0,0,0,8">
            <TextBox Style="{StaticResource LogTextBoxStyle}"
                     Text="{Binding LogContent, Mode=OneWay}"
                     BorderThickness="0"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </Border>

        <Border Grid.Row="6"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0">
            <Grid>
                <Button Content="?"
                        Width="22"
                        Height="22"
                        Style="{StaticResource HelpButtonStyle}"
                        Command="{Binding ShowHelpCommand}"
                        HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="停止"
                            Width="80"
                            Margin="0,0,10,0"
                            Style="{StaticResource CancelButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                            IsEnabled="{Binding IsProcessing}"/>
                    <Button Content="开始"
                            Width="80"
                            Style="{StaticResource ExecuteButtonStyle}"
                            Command="{Binding RunCommand}"
                            IsEnabled="{Binding CanProcess}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
