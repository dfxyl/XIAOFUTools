<Window x:Class="XIAOFUTools.Tools.MultiOverlaySummary.ExportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出结果" Height="200" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="请选择要导出的内容：" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="1" Margin="10,0,0,0">
            <CheckBox x:Name="ExportExcelCheckBox" Content="导出汇总表格 (Excel/CSV)" IsChecked="True" Margin="0,5"/>
            <CheckBox x:Name="ExportGdbCheckBox" Content="导出压盖图形 (GDB)" IsChecked="False" Margin="0,5"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Width="70" Height="26" Margin="0,0,10,0"
                    Style="{StaticResource CancelButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="导出" Width="70" Height="26"
                    Style="{StaticResource ExecuteButtonStyle}"
                    Click="Export_Click"/>
        </StackPanel>
    </Grid>
</Window>
