<UserControl x:Class="XIAOFUTools.Tools.Edit.Boundary.ModifyStartPoint.ModifyStartPointView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 图层选择 -->
        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Text="选择面图层:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,10"/>
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      x:Name="LayerComboBox"
                      Style="{StaticResource ComboBoxStyle}"/>
            <Button Grid.Column="1" Width="26" Height="26" Margin="5,0,0,0"
                    Style="{StaticResource DefaultButtonStyle}"
                    Click="RefreshLayersButton_Click"
                    ToolTip="刷新图层列表"
                    VerticalAlignment="Center">
                <TextBlock Text="⟲" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
        
        <!-- 起始角选择 -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="起始角:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,10"/>
        <ComboBox Grid.Row="1" Grid.Column="1" 
                  x:Name="CornerComboBox" 
                  Style="{StaticResource ComboBoxStyle}"
                  Margin="0,0,0,10"/>
        
        <!-- 角度阈值 -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="内角阈值(度):" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,10"/>
        <StackPanel Grid.Row="2" Grid.Column="1" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,10">
            <TextBox x:Name="AngleThresholdTextBox" 
                     Text="179" 
                     Width="100" 
                     Style="{StaticResource TextBoxStyle}"
                     VerticalAlignment="Center"/>
            <TextBlock Text="(0-180)" 
                       VerticalAlignment="Center" 
                       Margin="10,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        
        <!-- 进度条 -->
        <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                     x:Name="ProgressBar" 
                     Style="{StaticResource ProgressBarStyle}" 
                     Height="6" 
                     Margin="0,0,0,2" 
                     Visibility="Collapsed"/>
        
        <!-- 日志窗口 -->
        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                BorderBrush="#CDCDCD" 
                BorderThickness="1"
                Margin="0,0,0,10"
                MinHeight="100"
                VerticalAlignment="Stretch">
            <TextBox x:Name="LogTextBox"
                     Style="{StaticResource LogTextBoxStyle}"
                     BorderThickness="0"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"/>
        </Border>
        
        <!-- 按钮区域 -->
        <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 帮助按钮（左侧） -->
            <Button Grid.Column="0" 
                    x:Name="HelpButton"
                    Content="?" 
                    Click="HelpButton_Click"
                    Style="{StaticResource HelpButtonStyle}"
                    HorizontalAlignment="Left"/>

            <!-- 执行按钮（右侧） -->
            <Button Grid.Column="2"
                    x:Name="StartButton" 
                    Content="执行" 
                    Click="StartButton_Click" 
                    Style="{StaticResource ExecuteButtonStyle}"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
