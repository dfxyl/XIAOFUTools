<UserControl x:Class="XIAOFUTools.Tools.Edit.Boundary.BoundaryPointLineGenerator.BoundaryPointLineGeneratorDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 新增参数行 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 自定义输出路径（JZD/JZX） -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 日志区域占据剩余空间 -->
            <RowDefinition Height="*"/>
            <!-- 底部按钮区域 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 面要素图层 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="面要素图层:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 图层下拉与刷新 -->
            <ComboBox Grid.Row="0" Grid.Column="0"
                      Style="{StaticResource ComboBoxStyle}"
                      ItemsSource="{Binding PolygonLayers}"
                      SelectedItem="{Binding SelectedPolygonLayer}"
                      DisplayMemberPath="Name"/>
            <Button Grid.Row="0" Grid.Column="1" Width="22" Height="22" Margin="5,0,0,0"
                    Style="{StaticResource DefaultButtonStyle}"
                    Command="{Binding RefreshLayersCommand}" ToolTip="刷新图层列表">
                <TextBlock Text="⟲" FontSize="14" FontWeight="Bold"/>
            </Button>

            <!-- 使用所选记录 滑动开关（有选择时显示，无选择时隐藏） -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding UseSelection}" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ToggleButton x:Name="UseSelectionSwitch"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding UseSelection, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource InfoTextBlockStyle}">
                    <Run Text="使用所选记录："/>
                    <Run Text="{Binding SelectedCount}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 宗地代码字段（可选） -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="宗地代码字段:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,10"
                  ItemsSource="{Binding AvailableFields}"
                  SelectedItem="{Binding SelectedCodeFieldName}"/>

        <!-- 生成类型 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="生成类型:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,10"
                  ItemsSource="{Binding OutputTypes}"
                  SelectedItem="{Binding SelectedOutputType}"/>

        <!-- 输出信息（只读） -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="默认数据库:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DefaultGdbPath}" VerticalAlignment="Center" Margin="0,0,0,10"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="输出要素类:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OutputFeatureClassName}" VerticalAlignment="Center" Margin="0,0,0,10"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <!-- JZD 要素代码(YSDM) -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="JZD 要素代码(YSDM):" VerticalAlignment="Center" Margin="0,0,10,10"
                   Visibility="{Binding ShowJZDSettings, Converter={StaticResource BoolToVis}}"/>
        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,10"
                 Text="{Binding JZDYSDM}"
                 Visibility="{Binding ShowJZDSettings, Converter={StaticResource BoolToVis}}"/>

        <!-- JZX 要素代码(YSDM) -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="JZX 要素代码(YSDM):" VerticalAlignment="Center" Margin="0,0,10,10"
                   Visibility="{Binding ShowJZXSettings, Converter={StaticResource BoolToVis}}"/>
        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,10"
                 Text="{Binding JZXYSDM}"
                 Visibility="{Binding ShowJZXSettings, Converter={StaticResource BoolToVis}}"/>

        <!-- JZDH 前缀 -->
        <TextBlock Grid.Row="7" Grid.Column="0" Text="JZDH 前缀:" VerticalAlignment="Center" Margin="0,0,10,10"
                   Visibility="{Binding ShowJZDSettings, Converter={StaticResource BoolToVis}}"/>
        <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,10"
                 Text="{Binding JZDHPrefix}"
                 Visibility="{Binding ShowJZDSettings, Converter={StaticResource BoolToVis}}"/>

        <!-- JZX 边长保留小数位 -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="JZX 边长小数位:" VerticalAlignment="Center" Margin="0,0,10,10"
                   Visibility="{Binding ShowJZXSettings, Converter={StaticResource BoolToVis}}"/>
        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,10"
                 Text="{Binding JZXLengthDecimals}"
                 Visibility="{Binding ShowJZXSettings, Converter={StaticResource BoolToVis}}"/>

        <!-- JZD 输出路径（根据类型显示） -->
        <TextBlock Grid.Row="9" Grid.Column="0" Text="JZD 输出路径:" VerticalAlignment="Center" Margin="0,0,10,10"
                   Visibility="{Binding ShowJZDSettings, Converter={StaticResource BoolToVis}}"/>
        <Grid Grid.Row="9" Grid.Column="1" Margin="0,0,0,10"
              Visibility="{Binding ShowJZDSettings, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="{Binding OutputPathJZD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Width="80" Margin="6,0,0,0" Content="浏览..." Style="{StaticResource DefaultButtonStyle}"
                    Command="{Binding BrowseOutputJZDCommand}"/>
        </Grid>

        <!-- JZX 输出路径（根据类型显示） -->
        <TextBlock Grid.Row="10" Grid.Column="0" Text="JZX 输出路径:" VerticalAlignment="Center" Margin="0,0,10,10"
                   Visibility="{Binding ShowJZXSettings, Converter={StaticResource BoolToVis}}"/>
        <Grid Grid.Row="10" Grid.Column="1" Margin="0,0,0,10"
              Visibility="{Binding ShowJZXSettings, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="{Binding OutputPathJZX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Width="80" Margin="6,0,0,0" Content="浏览..." Style="{StaticResource DefaultButtonStyle}"
                    Command="{Binding BrowseOutputJZXCommand}"/>
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#CDCDCD" BorderThickness="1" Margin="0,0,0,10">
            <TextBox Style="{StaticResource LogTextBoxStyle}"
                     Text="{Binding LogContent, Mode=OneWay}"
                     BorderThickness="0"/>
        </Border>

        <!-- 底部按钮与进度 -->
        <Grid Grid.Row="12" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0" Height="6" Margin="0,0,0,6"
                         Style="{StaticResource ProgressBarStyle}"
                         Value="{Binding Progress}" Minimum="0" Maximum="100"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="?" Width="22" Height="22" Style="{StaticResource HelpButtonStyle}"
                        Command="{Binding ShowHelpCommand}"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="停止" Width="80" Margin="0,0,10,0" Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding CancelCommand}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="3" Content="开始" Width="80" Style="{StaticResource ExecuteButtonStyle}"
                        Command="{Binding RunCommand}" IsEnabled="{Binding CanProcess}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
