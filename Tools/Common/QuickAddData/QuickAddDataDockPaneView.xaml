<UserControl x:Class="XIAOFUTools.Tools.QuickAddData.QuickAddDataDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XIAOFUTools.Tools.QuickAddData"
             xmlns:frameworkDragDrop="clr-namespace:ArcGIS.Desktop.Framework.DragDrop;assembly=ArcGIS.Desktop.Framework"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#CDCDCD" BorderThickness="1">
            <TreeView x:Name="LibraryTree"
                      ItemsSource="{Binding TreeNodes}"
                      AllowDrop="True"
                      FontSize="13"
                      frameworkDragDrop:DragDrop.IsDragSource="True"
                      frameworkDragDrop:DragDrop.DragHandler="{Binding TreeDragDropHandler}"
                      frameworkDragDrop:DragDrop.IsDropTarget="True"
                      frameworkDragDrop:DragDrop.DropHandler="{Binding TreeDragDropHandler}"
                      SelectedItemChanged="LibraryTree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="LibraryTree_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="LibraryTree_PreviewMouseMove"
                      MouseDoubleClick="LibraryTree_MouseDoubleClick">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:QuickDataTreeItemViewModel}"
                                              ItemsSource="{Binding Children}">
                        <Border Padding="6,3"
                                Margin="0,2,0,2"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                ToolTip="{Binding ToolTipText}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <!-- ViewModel 的 IsSelected 属性控制多选蓝色背景 -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#DCEEFF"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        </DataTrigger>
                                        <!-- TreeViewItem 的 IsSelected 属性控制焦点项的边框 -->
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding IconGlyph}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           Margin="0,0,6,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TypeDisplayText}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="添加文件"
                                              Visibility="{Binding AddFileToGroupVisibility}"
                                              Command="{Binding PlacementTarget.Tag.AddFilesToSelectedGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="扫描目录"
                                              Visibility="{Binding ImportToGroupVisibility}"
                                              Command="{Binding PlacementTarget.Tag.ImportToSelectedGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="加载本组"
                                              Visibility="{Binding LoadGroupVisibility}"
                                              Command="{Binding PlacementTarget.Tag.LoadSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="重命名"
                                              Visibility="{Binding RenameGroupVisibility}"
                                              Command="{Binding PlacementTarget.Tag.RenameSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="加载本类"
                                              Visibility="{Binding LoadBucketVisibility}"
                                              Command="{Binding PlacementTarget.Tag.LoadSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{Binding LoadMenuHeader}"
                                              Visibility="{Binding LoadNodeVisibility}"
                                              Command="{Binding PlacementTarget.Tag.LoadSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="刷新子项"
                                              Visibility="{Binding RefreshDatabaseVisibility}"
                                              Command="{Binding PlacementTarget.Tag.RefreshSelectedDatabaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator Visibility="{Binding DeleteVisibility}"/>
                                    <MenuItem Header="删除"
                                              Visibility="{Binding DeleteVisibility}"
                                              Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,10,0,0"
                Padding="0,10,0,0">
            <Grid>
                <Button Content="?"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource HelpButtonStyle}"
                        Command="{Binding ShowHelpCommand}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="新建组"
                            Width="86"
                            Margin="0,0,8,0"
                            Style="{StaticResource DefaultButtonStyle}"
                            Command="{Binding CreateGroupCommand}"/>
                    <Button x:Name="ImportButton"
                            Content="导入"
                            Width="86"
                            Margin="0,0,8,0"
                            Style="{StaticResource DefaultButtonStyle}"
                            Click="ImportButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Top"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="添加文件"
                                          Command="{Binding AddFilesCommand}"/>
                                <MenuItem Header="扫描目录"
                                          Command="{Binding ImportFolderCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
