<UserControl x:Class="XIAOFUTools.Tools.User.Custom.DevZoneCheck.DevZoneCheckDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XIAOFUTools.Tools.User.Custom.DevZoneCheck"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="480"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="LocalHelpButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部固定：园区红线设置 -->
        <GroupBox Grid.Row="0" Header="园区红线" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="园区图层:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource ComboBoxStyle}"
                        ItemsSource="{Binding PolygonLayers}"
                        SelectedItem="{Binding SelectedParkLayer}"
                        DisplayMemberPath="Name"
                        Margin="0,0,0,5"/>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="5,0,0,5" VerticalAlignment="Center">
                    <Button Width="22" Height="22"
                            Style="{StaticResource DefaultButtonStyle}"
                            Command="{Binding RefreshLayersCommand}"
                            ToolTip="刷新图层列表">
                        <TextBlock Text="⟲" FontSize="14" FontWeight="Bold"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="60" Height="22" Margin="5,0,0,0"
                            Style="{StaticResource DefaultButtonStyle}"
                            Command="{Binding AutoMatchLayersCommand}"
                            ToolTip="根据图层名称自动匹配所有图层">
                        <TextBlock Text="自动匹配" FontSize="11"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="分组字段:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                        Style="{StaticResource ComboBoxStyle}"
                        ItemsSource="{Binding ParkFields}"
                        SelectedItem="{Binding SelectedParkField}"
                        ToolTip="可选，用于按园区分组统计"/>
            </Grid>
        </GroupBox>

        <!-- 中间滚动区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 底线类核查 - 可收起 -->
                <Expander Header="底线类核查" IsExpanded="True" Margin="0,0,0,5">
                    <Border BorderBrush="#CDCDCD" BorderThickness="1,0,1,1" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="城镇开发边界:" IsChecked="{Binding EnableUrbanBoundary}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding UrbanBoundaryLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableUrbanBoundary}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="永久基本农田:" IsChecked="{Binding EnablePermanentFarmland}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding PermanentFarmlandLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnablePermanentFarmland}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="生态保护红线:" IsChecked="{Binding EnableEcoRedline}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding EcoRedlineLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableEcoRedline}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 节约集约类核查 - 可收起 -->
                <Expander Header="节约集约类核查" IsExpanded="True" Margin="0,0,0,5">
                    <Border BorderBrush="#CDCDCD" BorderThickness="1,0,1,1" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="变更调查数据:" IsChecked="{Binding EnableLandSurvey}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding LandSurveyLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableLandSurvey}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5" Visibility="{Binding EnableLandSurvey, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="  地类代码字段:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding LandSurveyFields}"
                                        SelectedItem="{Binding SelectedLandSurveyField}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="已批建设用地:" IsChecked="{Binding EnableApprovedLand}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding ApprovedLandLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableApprovedLand}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5" Visibility="{Binding EnableApprovedLand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="  批而未供数据:" IsChecked="{Binding EnableApprovedNotSupplied}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="需要已批建设用地数据"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding ApprovedNotSuppliedLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableApprovedNotSupplied}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="已供应数据:" IsChecked="{Binding EnableSuppliedLand}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding SuppliedLandLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableSuppliedLand}"/>
                            </Grid>
                            <Grid Visibility="{Binding EnableSuppliedLand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="  闲置土地数据:" IsChecked="{Binding EnableIdleLand}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="需要已供应建设用地数据"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding IdleLandLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableIdleLand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 发展空间类核查 - 可收起 -->
                <Expander Header="发展空间类核查" IsExpanded="True" Margin="0,0,0,5">
                    <Border BorderBrush="#CDCDCD" BorderThickness="1,0,1,1" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="国土空间规划:" IsChecked="{Binding EnableSpatialPlanning}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding SpatialPlanningLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableSpatialPlanning}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5" Visibility="{Binding EnableSpatialPlanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="  用地代码字段:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding SpatialPlanningFields}"
                                        SelectedItem="{Binding SelectedSpatialPlanningField}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5" Visibility="{Binding ShowEvidenceDataOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="  举证数据:" IsChecked="{Binding EnableEvidenceData}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="需要国土空间规划和已供应建设用地数据"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding EvidenceDataLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableEvidenceData}"/>
                            </Grid>
                            <Grid Visibility="{Binding ShowEvidenceDataOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="  年限数据:" IsChecked="{Binding EnableSupplyYearData}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="用于计算统计年限，每个要素代表一年"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                        ItemsSource="{Binding PolygonLayers}"
                                        SelectedItem="{Binding SupplyYearDataLayer}"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding EnableSupplyYearData}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 输出设置 -->
                <GroupBox Header="输出设置" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,5">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="面积单位:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                    ItemsSource="{Binding AreaUnits}"
                                    SelectedItem="{Binding SelectedAreaUnit}"
                                    Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="小数位:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="3" Style="{StaticResource TextBoxStyle}"
                                   Text="{Binding DecimalPlaces}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="计算方式:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                    ItemsSource="{Binding AreaCalculationMethods}"
                                    SelectedItem="{Binding SelectedAreaCalculationMethod}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 进度条 -->
                <ProgressBar Margin="0,5,0,5"
                           Style="{StaticResource ProgressBarStyle}"
                           Value="{Binding Progress}"
                           Minimum="0" Maximum="100"
                           IsIndeterminate="{Binding IsProgressIndeterminate}"
                           Height="6"/>

                <!-- 日志窗口 -->
                <Border BorderBrush="#CDCDCD" BorderThickness="1" Margin="0,0,0,5">
                    <TextBox Style="{StaticResource LogTextBoxStyle}"
                          Text="{Binding LogContent, Mode=OneWay}"
                          BorderThickness="0"
                          MinHeight="80"
                          MaxHeight="200"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          IsReadOnly="True"
                          TextWrapping="Wrap"
                          VerticalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定：按钮区域 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}"
               BorderThickness="0,1,0,0"
               Margin="0,8,0,0"
               Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="?" Width="22" Height="22"
                        Style="{StaticResource LocalHelpButtonStyle}"
                        Command="{Binding ShowHelpCommand}"
                        ToolTip="查看工具使用说明"/>
                <Button Content="导出报告" Height="22" Margin="8,0,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding ExportReportCommand}"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="导出核查报告到Excel"/>
                <Button Content="停止" Margin="8,0,0,0"
                        Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsProcessing}"/>
                <Button Content="开始核查" Margin="8,0,0,0"
                        Style="{StaticResource ExecuteButtonStyle}"
                        Command="{Binding RunCommand}"
                        IsEnabled="{Binding CanProcess}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
