<controls:ProWindow x:Class="XIAOFUTools.Tools.User.AIAssistant.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="AI 助手设置" 
        Height="560" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <controls:ProWindow.Resources>
        <!-- 基础文本样式 -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DescStyle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6b7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <!-- 美化下拉框 -->
        <Style TargetType="ComboBox" x:Key="ModernComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- 美化文本框 -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <!-- 主要按钮 -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e40af"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 次要按钮 -->
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 危险按钮 -->
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Background" Value="#fee2e2"/>
            <Setter Property="Foreground" Value="#dc2626"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#fecaca"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 小按钮 -->
        <Style TargetType="Button" x:Key="SmallButton">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 导航按钮样式 -->
        <Style TargetType="RadioButton" x:Key="NavButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" Padding="12,10" Cursor="Hand" CornerRadius="6" Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="text" Text="{TemplateBinding Content}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#dbeafe"/>
                                <Setter TargetName="text" Property="Foreground" Value="#1d4ed8"/>
                                <Setter TargetName="text" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:ProWindow.Resources>
    
    <Grid Background="#f9fafb">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 左侧导航 -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="White" BorderBrush="#e5e7eb" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,12">
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" Foreground="#111827" Margin="8,0,8,16"/>
                <RadioButton x:Name="navPython" Content="Python 执行" Tag="🐍" Style="{StaticResource NavButton}" IsChecked="True"/>
                <RadioButton x:Name="navModel" Content="模型配置" Tag="🤖" Style="{StaticResource NavButton}" Checked="NavItem_Checked"/>
                <RadioButton x:Name="navAbout" Content="关于" Tag="ℹ️" Style="{StaticResource NavButton}" Checked="NavItem_Checked"/>
            </StackPanel>
        </Border>
        
        <!-- 右侧内容区 -->
        <Grid Grid.Column="1" Grid.Row="0">
            <!-- Python 执行设置 -->
            <ScrollViewer x:Name="panelPython" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock Text="Python 执行设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="执行模式" Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource DescStyle}" Text="控制 Python 代码执行时是否弹出安全确认框。"/>
                            <ComboBox x:Name="cmbExecutionMode" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                <ComboBoxItem Content="每次询问 - 每次执行都弹出确认框"/>
                                <ComboBoxItem Content="不询问 - 首次信任后不再弹窗（推荐）"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#eff6ff" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="💡 关于「不询问」模式" FontSize="11" FontWeight="SemiBold" Foreground="#1d4ed8" Margin="0,0,0,4"/>
                            <TextBlock Text="使用固定位置的工具箱，首次运行时点击「允许」后，后续执行将不再弹窗。" 
                                       FontSize="11" Foreground="#1e40af" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 模型配置 -->
            <ScrollViewer x:Name="panelModel" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模型配置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+ 添加模型" Style="{StaticResource PrimaryButton}" Click="BtnAddModel_Click" Margin="0,0,8,0"/>
                            <Button Content="重置默认" Style="{StaticResource SecondaryButton}" Click="BtnResetModels_Click"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- 模型列表（由代码动态生成） -->
                    <StackPanel x:Name="modelListPanel"/>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 关于 -->
            <ScrollViewer x:Name="panelAbout" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <Border Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="XIAOFUTools AI 助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="版本：1.0.0" Foreground="#6b7280" FontSize="12" Margin="0,0,0,12"/>
                            <TextBlock Text="一个集成在 ArcGIS Pro 中的 AI 助手，支持智能对话、Python 代码执行等功能。" 
                                       Foreground="#374151" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <Border Background="#fef3c7" CornerRadius="6" Padding="12">
                                <TextBlock Text="⚠️ 回答由 AI 生成，仅供参考。数据无价，谨慎操作。" 
                                           FontSize="11" Foreground="#92400e" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <!-- 底部按钮 -->
        <Border Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="#e5e7eb" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</controls:ProWindow>
