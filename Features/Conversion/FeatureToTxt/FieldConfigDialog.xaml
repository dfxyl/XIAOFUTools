<Window x:Class="XIAOFUTools.Features.Conversion.FeatureToTxt.FieldConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XIAOFUTools.Features.Conversion.FeatureToTxt"
        Title="输出字段配置" 
        Height="550" Width="750"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="White">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Shared/Presentation/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 布尔值转可见性转换器 -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <!-- 字段名称转颜色转换器 -->
            <local:FieldNameToColorConverter x:Key="FieldNameToColorConverter"/>
            <!-- 分隔线判断转换器 -->
            <local:SeparatorConverter x:Key="SeparatorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部快捷操作 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Content="📌 推荐字段" Command="{Binding AddMappedFieldsCommand}" Style="{StaticResource DefaultButtonStyle}" MinWidth="90" Height="30" Margin="0,0,8,0"/>
            <Button Content="📋 全部字段" Command="{Binding AddAllActualFieldsCommand}" Style="{StaticResource DefaultButtonStyle}" MinWidth="90" Height="30" Margin="0,0,8,0"/>
            <Button Content="🔄 重置默认" Command="{Binding ResetDefaultFieldsCommand}" Style="{StaticResource DefaultButtonStyle}" MinWidth="90" Height="30" Margin="0,0,8,0"/>
            <Button Content="🗑 清空" Command="{Binding ClearAllOutputFieldsCommand}" Style="{StaticResource CancelButtonStyle}" MinWidth="70" Height="30"/>
        </StackPanel>

        <!-- 字段配置区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：可用字段 -->
            <GroupBox Grid.Column="0" Header="📋 可用字段" Style="{StaticResource GroupBoxStyle}" Margin="0,0,8,0">
                <Border BorderBrush="#E0E0E0" BorderThickness="1" Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="AvailableFieldsList"
                                 ItemsSource="{Binding AvailableFields}"
                                 SelectionMode="Extended"
                                 Margin="4"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Style.Triggers>
                                        <!-- 分隔线样式 -->
                                        <DataTrigger Binding="{Binding Converter={StaticResource SeparatorConverter}}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#999999"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0,8,0,8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </GroupBox>

            <!-- 中：操作按钮 -->
            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                <Button Content="添加 →" Margin="0,0,0,8" Style="{StaticResource DefaultButtonStyle}"
                        MinWidth="70" Height="32"
                        Command="{Binding AddOutputFieldCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=AvailableFieldsList}"/>
                <Separator Margin="0,4,0,4"/>
                <Button Content="⬆ 上移" Margin="0,0,0,8" Style="{StaticResource DefaultButtonStyle}" 
                        MinWidth="70" Height="32"
                        Command="{Binding MoveUpCommand}"/>
                <Button Content="⬇ 下移" Margin="0,0,0,8" Style="{StaticResource DefaultButtonStyle}" 
                        MinWidth="70" Height="32"
                        Command="{Binding MoveDownCommand}"/>
                <Button Content="❌ 删除" Style="{StaticResource CancelButtonStyle}" 
                        MinWidth="70" Height="32"
                        Command="{Binding RemoveSelectedOutputFieldCommand}"/>
            </StackPanel>

            <!-- 右：已选字段（有序） -->
            <GroupBox Grid.Column="2" Header="✅ 已选字段（输出顺序）" Style="{StaticResource GroupBoxStyle}">
                <Border BorderBrush="#E0E0E0" BorderThickness="1" Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding OutputFields}"
                                 SelectedItem="{Binding SelectedOutputField, Mode=TwoWay}"
                                 Margin="4"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding FieldName, Converter={StaticResource FieldNameToColorConverter}}"
                                            BorderBrush="#B0C4DE" BorderThickness="1"
                                            CornerRadius="2" Margin="1" Padding="4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FieldName}" FontWeight="Bold" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="×" Width="12" Height="12"
                                                    FontSize="8" Padding="0" Margin="0" FontWeight="Bold"
                                                    Background="Red" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.RemoveOutputFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="删除此字段"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </GroupBox>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✔ 确定" Width="90" Height="34" Margin="0,0,8,0" Style="{StaticResource ExecuteButtonStyle}" Click="OkButton_Click"/>
            <Button Content="✖ 取消" Width="80" Height="34" Style="{StaticResource CancelButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
