<UserControl x:Class="XIAOFUTools.Features.General.InternetTileDownload.InternetTileDownloadDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="430"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Shared/Presentation/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="服务链接" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding ServiceUrl, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxStyle}"/>
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="解析"
                    Command="{Binding ResolveServiceCommand}"
                    Style="{StaticResource ExecuteButtonStyle}"
                    IsEnabled="{Binding CanResolve}"/>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#CDCDCD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding ServiceSummary}"
                       Foreground="Gray"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="下载级别" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding LevelOptions}"
                      SelectedItem="{Binding SelectedLevelOption}"
                      Style="{StaticResource ComboBoxStyle}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="范围来源" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AreaSourceOptions}"
                      SelectedItem="{Binding SelectedAreaSourceOption}"
                      Style="{StaticResource ComboBoxStyle}"/>
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="框选"
                    Command="{Binding DrawExtentCommand}"
                    Style="{StaticResource DefaultButtonStyle}"
                    Visibility="{Binding IsCustomExtentSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,8"
              Visibility="{Binding IsFeatureLayerSource, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="面图层" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FeatureLayers}"
                      SelectedItem="{Binding SelectedFeatureLayer}"
                      DisplayMemberPath="Name"
                      Style="{StaticResource ComboBoxStyle}"/>
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="刷新图层"
                    Command="{Binding RefreshLayersCommand}"
                    Style="{StaticResource DefaultButtonStyle}"/>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="{Binding AreaSummary}" Foreground="Gray" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="输出文件夹" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding OutputFolderPath}" Style="{StaticResource TextBoxStyle}" />
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="浏览"
                        Command="{Binding BrowseOutputFolderCommand}"
                        Style="{StaticResource DefaultButtonStyle}"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="输出坐标" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding OutputSpatialReferenceDisplay}"
                         Style="{StaticResource TextBoxStyle}"
                         IsReadOnly="True"/>
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="选择"
                        Command="{Binding PickSpatialReferenceCommand}"
                        Style="{StaticResource DefaultButtonStyle}"/>
            </Grid>
        </StackPanel>

        <ProgressBar Grid.Row="6"
                     Style="{StaticResource ProgressBarStyle}"
                     Height="6"
                     Value="{Binding Progress}"
                     Margin="0,0,0,6"/>

        <Grid Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,0,0,4"/>
            <Border Grid.Row="1" BorderBrush="#CDCDCD" BorderThickness="1" Margin="0,0,0,8">
                <TextBox Text="{Binding LogContent}"
                         Style="{StaticResource LogTextBoxStyle}"
                         BorderThickness="0"
                         IsReadOnly="True"/>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="?"
                        Width="22"
                        Height="22"
                        Style="{StaticResource HelpButtonStyle}"
                        Command="{Binding ShowHelpCommand}"/>
                <Grid Grid.Column="1"/>
                <Button Grid.Column="2"
                        Content="取消"
                        Width="80"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource CancelButtonStyle}"
                        IsEnabled="{Binding IsProcessing}"/>
                <Button Grid.Column="3"
                        Content="下载"
                        Width="80"
                        Command="{Binding DownloadCommand}"
                        Style="{StaticResource ExecuteButtonStyle}"
                        IsEnabled="{Binding CanDownload}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
