<UserControl x:Class="XIAOFUTools.Features.DataManagement.DatabaseBuilder.DatabaseBuilderDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:local="clr-namespace:XIAOFUTools.Features.DataManagement.DatabaseBuilder"
             mc:Ignorable="d"
             d:DataContext="{Binding Path=DatabaseBuilderViewModel}"
             d:DesignHeight="600" d:DesignWidth="350">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 引用自定义样式 -->
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Shared/Presentation/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 布尔值反转转换器 -->
            <local:BooleanInverseConverter x:Key="BooleanInverseConverter"/>

            <!-- 局部样式重写 -->
            <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlockStyle}">
                <Setter Property="Margin" Value="0,3,10,0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="Height" Value="26"/>
            </Style>

            <Style x:Key="BrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="#CDCDCD" BorderThickness="0" CornerRadius="0">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 输入Excel文件 -->
            <GroupBox Grid.Row="0" Header="输入参数"
                     Style="{StaticResource GroupBoxStyle}"
                     Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="属性结构表 (Excel):"
                              Style="{StaticResource FormLabelStyle}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Style="{StaticResource FormTextBoxStyle}"
                                Text="{Binding InputExcelPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanInverseConverter}}"
                                ToolTip="选择包含图层和字段定义的Excel文件"/>
                        <Button Grid.Column="1"
                               Content="浏览"
                               Style="{StaticResource BrowseButtonStyle}"
                               Command="{Binding BrowseInputExcelCommand}"
                               IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanInverseConverter}}"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- 输出参数 -->
            <GroupBox Grid.Row="1" Header="输出参数"
                     Style="{StaticResource GroupBoxStyle}"
                     Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="输出数据库位置:"
                              Style="{StaticResource FormLabelStyle}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Style="{StaticResource FormTextBoxStyle}"
                                Text="{Binding OutputFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanInverseConverter}}"
                                ToolTip="选择输出文件地理数据库的保存位置"/>
                        <Button Grid.Column="1"
                               Content="浏览"
                               Style="{StaticResource BrowseButtonStyle}"
                               Command="{Binding BrowseOutputFolderCommand}"
                               IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanInverseConverter}}"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="数据库名称:"
                              Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="3"
                            Style="{StaticResource FormTextBoxStyle}"
                            Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanInverseConverter}}"
                            ToolTip="输入要创建的文件地理数据库名称（不含.gdb后缀）"/>

                    <TextBlock Grid.Row="4" Text="图层坐标系:"
                              Style="{StaticResource FormLabelStyle}"/>
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Margin="0,2,0,8"
                                Height="26"
                                BorderBrush="#CDCDCD"
                                BorderThickness="1"
                                Background="#F5F5F5">
                            <TextBlock Text="{Binding SelectedCoordinateSystemName}"
                                      VerticalAlignment="Center"
                                      Margin="8,0,8,0"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="当前用于建库的坐标系"/>
                        </Border>
                        <Button Grid.Column="1"
                               Content="选择"
                               Style="{StaticResource BrowseButtonStyle}"
                               Command="{Binding SelectCoordinateSystemCommand}"
                               IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanInverseConverter}}"
                               ToolTip="设置新建要素集和要素类坐标系"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- 日志区域 -->
            <GroupBox Grid.Row="2" Header="操作日志"
                     Style="{StaticResource GroupBoxStyle}"
                     Margin="0,0,0,6">
                <TextBox Text="{Binding LogText, Mode=OneWay}"
                        Style="{StaticResource LogTextBoxStyle}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>

            <!-- 底部按钮 -->
            <Grid Grid.Row="3">
                <Border BorderBrush="{StaticResource DividerBrush}"
                       BorderThickness="0,1,0,0"
                       Margin="0,4,0,0"
                       Padding="0,6,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="HelpButton" Content="?"
                                    Style="{StaticResource HelpButtonStyle}"
                                    Command="{Binding ShowHelpCommand}"
                                    ToolTip="查看工具使用说明"/>
                            <Button Content="导出模板"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Width="80"
                                    Height="26"
                                    Margin="8,0,0,0"
                                    Command="{Binding ExportTemplateCommand}"
                                    IsEnabled="{Binding IsProcessing, Converter={StaticResource BooleanInverseConverter}}"
                                    ToolTip="导出建库Excel模板供参考制作"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="停止"
                                    Style="{StaticResource CancelButtonStyle}"
                                    Command="{Binding StopCommand}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>
                            <Button Content="开始建库"
                                    Style="{StaticResource ExecuteButtonStyle}"
                                    Command="{Binding StartCommand}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
