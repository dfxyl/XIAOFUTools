<UserControl x:Class="XIAOFUTools.Features.DataManagement.MdbBatchToGdb.MdbBatchToGdbDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:XIAOFUTools.Features.DataManagement.MdbBatchToGdb"
             mc:Ignorable="d"
            d:DesignHeight="660"
             d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Shared/Presentation/Styles/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:BooleanInverseConverter x:Key="BooleanInverseConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="输入文件夹" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding InputFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxStyle}"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}"
                         ToolTip="选择包含 MDB 的文件夹" />
                <Button Grid.Column="2"
                        Content="浏览"
                        Width="60"
                        Margin="8,0,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding BrowseInputFolderCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Content="遍历子文件夹"
                          IsChecked="{Binding IncludeSubfolders}"
                          Style="{StaticResource CheckBoxStyle}"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />
                <Button Grid.Column="1"
                        Content="重新扫描"
                        Width="75"
                        Margin="10,0,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding RefreshMdbListCommand}"
                        IsEnabled="{Binding CanRefresh}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding SelectionSummary}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>

            <CheckBox Grid.Row="2"
                      Content="输出到源路径"
                      IsChecked="{Binding SaveToSourcePath}"
                      Style="{StaticResource CheckBoxStyle}"
                      Margin="0,4,0,4"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />

            <Grid Grid.Row="3" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="输出格式" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding OutputFormats}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedOutputFormatOption, Mode=TwoWay}"
                          Style="{StaticResource ComboBoxStyle}"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />
            </Grid>

            <Grid Grid.Row="4"
                  Visibility="{Binding ShowOutputFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="输出文件夹" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding OutputFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxStyle}"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}"
                         ToolTip="选择转换结果的输出目录" />
                <Button Grid.Column="2"
                        Content="浏览"
                        Width="60"
                        Margin="8,0,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding BrowseOutputFolderCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <Button Content="全选"
                        Width="55"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding SelectAllCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />
                <Button Content="反选"
                        Width="55"
                        Margin="8,0,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding InvertSelectionCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />
                <Button Content="清空选择"
                        Width="70"
                        Margin="8,0,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding ClearSelectionCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#CDCDCD" BorderThickness="1">
                <DataGrid ItemsSource="{Binding MdbItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderThickness="0"
                          IsReadOnly="False"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="选中"
                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="45" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="95" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <ProgressBar Grid.Row="2"
                     Style="{StaticResource ProgressBarStyle}"
                     Value="{Binding Progress}"
                     Height="6"
                     Margin="0,0,0,8" />

        <Border Grid.Row="3" BorderBrush="#CDCDCD" BorderThickness="1" Margin="0,0,0,10">
            <TextBox Style="{StaticResource LogTextBoxStyle}"
                     Text="{Binding LogText, Mode=OneWay}"
                     BorderThickness="0" />
        </Border>

        <Border Grid.Row="4"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,5,0,0"
                Padding="0,10,0,0">
            <Grid>
                <Button Content="?"
                        Width="22"
                        Height="22"
                        Style="{StaticResource HelpButtonStyle}"
                        Command="{Binding ShowHelpCommand}"
                        HorizontalAlignment="Left"
                        ToolTip="查看工具说明" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="停止"
                            Width="80"
                            Margin="0,0,10,0"
                            Style="{StaticResource CancelButtonStyle}"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsProcessing}" />
                    <Button Content="运行"
                            Width="80"
                            Style="{StaticResource ExecuteButtonStyle}"
                            Command="{Binding RunCommand}"
                            IsEnabled="{Binding CanRun}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
