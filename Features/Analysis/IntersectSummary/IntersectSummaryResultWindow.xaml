<Window x:Class="XIAOFUTools.Features.Analysis.IntersectSummary.IntersectSummaryResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="交集汇总结果" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Shared/Presentation/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 结果表格 - 可选择复制 -->
        <DataGrid x:Name="ResultDataGrid"
                  Grid.Row="0"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  Style="{StaticResource DataGridStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  GridLinesVisibility="All"
                  AlternatingRowBackground="#F5F5F5"
                  Margin="0,0,0,10">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制选中单元格 (Ctrl+C)" Click="CopySelectedCells_Click"/>
                    <MenuItem Header="复制全部数据" Click="CopyAllData_Click"/>
                    <Separator/>
                    <MenuItem Header="全选 (Ctrl+A)" Click="SelectAll_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        
        <!-- 底部按钮区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" x:Name="InfoText" VerticalAlignment="Center" 
                       Foreground="#666666" FontSize="11"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制全部" Width="70" Height="24" Margin="0,0,8,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Click="CopyAllData_Click"
                        ToolTip="复制所有数据到剪贴板"/>
                <Button Content="导出Excel" Width="70" Height="24" Margin="0,0,8,0"
                        Style="{StaticResource ExecuteButtonStyle}"
                        Click="ExportExcel_Click"
                        ToolTip="导出为Excel文件"/>
                <Button Content="关闭" Width="60" Height="24"
                        Style="{StaticResource CancelButtonStyle}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
