<UserControl x:Class="XIAOFUTools.Features.Analysis.LandClassTable.LandClassTableDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="450"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Shared/Presentation/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <DataTemplate x:Key="FieldItemTemplate">
                <TextBlock Text="{Binding DisplayText}"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="输出设置" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="面积单位:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemsSource="{Binding AreaUnits}"
                              SelectedItem="{Binding SelectedAreaUnit}"
                              Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="保留位数:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="2"
                             Style="{StaticResource TextBoxStyle}"
                             Text="{Binding DecimalPlaces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="填表日期:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource TextBoxStyle}"
                         Text="{Binding ReportDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="分组输出:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Content="启用"
                              Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding UseGroupedOutput, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemsSource="{Binding RedlineOptionalFields}"
                              SelectedItem="{Binding SelectedGroupField, Mode=TwoWay}"
                              ItemTemplate="{StaticResource FieldItemTemplate}"
                              IsEnabled="{Binding IsGroupedOutputVisible}"/>
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="输出文件夹:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Style="{StaticResource TextBoxStyle}"
                         Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"/>
                <Button Grid.Row="3" Grid.Column="2" Content="浏览" Width="60" Margin="6,0,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding BrowseOutputCommand}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="项目红线" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="图层:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding PolygonLayers}"
                          SelectedItem="{Binding SelectedRedlineLayer}"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,6"/>
                <Button Grid.Row="0" Grid.Column="2" Width="28" Height="26" Margin="6,0,0,6"
                        Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding RefreshLayersCommand}"
                        ToolTip="刷新图层列表">
                    <TextBlock Text="⟲" FontSize="14" FontWeight="Bold"/>
                </Button>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="面积字段:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding RedlineNumericFields}"
                          SelectedItem="{Binding SelectedAreaField}"
                          ItemTemplate="{StaticResource FieldItemTemplate}"
                          Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="项目/权利人名称字段:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding RedlineFields}"
                          SelectedItem="{Binding SelectedProjectNameField}"
                          ItemTemplate="{StaticResource FieldItemTemplate}"
                          Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="地块名称字段:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding RedlineOptionalFields}"
                          SelectedItem="{Binding SelectedPlotNameField}"
                          ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </Grid>
        </GroupBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="地类图斑" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="图层:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding PolygonLayers}"
                                  SelectedItem="{Binding SelectedClassLayer}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="地类名称/编码字段:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding ClassFields}"
                                  SelectedItem="{Binding SelectedClassNameField}"
                                  ItemTemplate="{StaticResource FieldItemTemplate}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="权属来源:" VerticalAlignment="Center" Margin="0,6,10,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton Content="自动获取"
                                         Style="{StaticResource RadioButtonStyle}"
                                         GroupName="OwnerMappingMode"
                                         IsChecked="{Binding UseAutoOwnerMapping, Mode=TwoWay}"
                                         Margin="0,0,16,0"/>
                            <RadioButton Content="手动填写"
                                         Style="{StaticResource RadioButtonStyle}"
                                         GroupName="OwnerMappingMode"
                                         IsChecked="{Binding UseManualOwnerMapping, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="权属单位字段:" VerticalAlignment="Center" Margin="0,6,10,0"
                                   Visibility="{Binding IsAutoOwnerMapping, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding ClassFields}"
                                  SelectedItem="{Binding SelectedOwnerUnitField}"
                                  ItemTemplate="{StaticResource FieldItemTemplate}"
                                  Margin="0,6,0,0"
                                  Visibility="{Binding IsAutoOwnerMapping, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="权属性质字段:" VerticalAlignment="Center" Margin="0,6,10,0"
                                   Visibility="{Binding IsAutoOwnerMapping, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding ClassFields}"
                                  SelectedItem="{Binding SelectedOwnerNatureField}"
                                  ItemTemplate="{StaticResource FieldItemTemplate}"
                                  Margin="0,6,0,0"
                                  Visibility="{Binding IsAutoOwnerMapping, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="权属名称:" VerticalAlignment="Center" Margin="0,6,10,0"
                                   Visibility="{Binding IsManualOwnerMapping, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding ManualOwnerUnitName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,0"
                                 Visibility="{Binding IsManualOwnerMapping, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="权属类型:" VerticalAlignment="Center" Margin="0,6,10,0"
                                   Visibility="{Binding IsManualOwnerMapping, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding ManualOwnerNatureName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,0"
                                 Visibility="{Binding IsManualOwnerMapping, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </GroupBox>

                <ProgressBar Style="{StaticResource ProgressBarStyle}"
                             Value="{Binding Progress}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Height="6" Margin="0,0,0,6"/>
                <Border BorderBrush="#CDCDCD" BorderThickness="1" MinHeight="120">
                    <TextBox Style="{StaticResource LogTextBoxStyle}"
                             Text="{Binding LogContent, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,8,0,0" Padding="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="出图信息:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemsSource="{Binding ReportProfiles}"
                              SelectedItem="{Binding SelectedReportProfile}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="设置" Width="56" Margin="6,0,0,0"
                            Style="{StaticResource DefaultButtonStyle}"
                            Command="{Binding ManageReportProfilesCommand}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Button Content="?" Width="22" Height="22"
                            Style="{StaticResource HelpButtonStyle}"
                            Command="{Binding ShowHelpCommand}"
                            HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="停止" Width="80" Margin="0,0,10,0"
                                Style="{StaticResource CancelButtonStyle}"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="运行" Width="80"
                                Style="{StaticResource ExecuteButtonStyle}"
                                Command="{Binding RunCommand}"
                                IsEnabled="{Binding CanProcess}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
