<UserControl x:Class="XIAOFUTools.Features.Analysis.BrowseFeatures.BrowseFeaturesDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Shared/Presentation/Styles/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="目标图层:" Style="{StaticResource FormLabelStyle}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FeatureLayers}"
                      SelectedItem="{Binding SelectedLayer}"
                      DisplayMemberPath="Name"
                      Style="{StaticResource ComboBoxStyle}" />
            <Button Grid.Column="2"
                    Content="刷新图层"
                    Margin="8,0,0,0"
                    MinWidth="74"
                    Command="{Binding RefreshLayersCommand}"
                    Style="{StaticResource DefaultButtonStyle}" />
            <Button Grid.Column="3"
                    Content="刷新快照"
                    Margin="8,0,0,0"
                    MinWidth="74"
                    Command="{Binding RefreshSnapshotCommand}"
                    Style="{StaticResource ExecuteButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="遍历范围:" Style="{StaticResource FormLabelStyle}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ScopeModes}"
                      SelectedItem="{Binding SelectedScopeMode}"
                      Style="{StaticResource ComboBoxStyle}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="排序方式:" Style="{StaticResource FormLabelStyle}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SortModes}"
                      SelectedItem="{Binding SelectedSortMode}"
                      Style="{StaticResource ComboBoxStyle}" />
            <CheckBox Grid.Column="2"
                      Content="降序"
                      IsChecked="{Binding SortDescending}"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource CheckBoxStyle}" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding SortFields}"
                      SelectedItem="{Binding SelectedSortField}"
                      IsEnabled="{Binding IsFieldSortMode}"
                      Margin="8,0,0,0"
                      Style="{StaticResource ComboBoxStyle}" />
        </Grid>

        <Border Grid.Row="3" BorderBrush="#CDCDCD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <WrapPanel ItemHeight="28">
                <Button Content="首" Width="42" Command="{Binding FirstFeatureCommand}" Style="{StaticResource DefaultButtonStyle}" />
                <Button Content="上" Width="42" Margin="4,0,0,0" Command="{Binding PreviousFeatureCommand}" Style="{StaticResource DefaultButtonStyle}" />
                <Button Content="下" Width="42" Margin="4,0,0,0" Command="{Binding NextFeatureCommand}" Style="{StaticResource DefaultButtonStyle}" />
                <Button Content="末" Width="42" Margin="4,0,0,0" Command="{Binding LastFeatureCommand}" Style="{StaticResource DefaultButtonStyle}" />
                <Button Content="上一部件" Width="68" Margin="10,0,0,0" Command="{Binding PreviousPartCommand}" Style="{StaticResource DefaultButtonStyle}" />
                <Button Content="下一部件" Width="68" Margin="4,0,0,0" Command="{Binding NextPartCommand}" Style="{StaticResource DefaultButtonStyle}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="位置:" Style="{StaticResource FormLabelStyle}" />
            <TextBlock Grid.Column="1" Text="{Binding SnapshotInfo}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="OID:" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding CurrentOidText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="部件:" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="{Binding PartInfoText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6"
                       Text="{Binding StaleHint}"
                       Margin="8,0,0,0"
                       Foreground="#CC3300"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="5" BorderBrush="#CDCDCD" BorderThickness="1" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding SnapshotList}"
                     SelectedItem="{Binding SelectedSnapshotItem, Mode=TwoWay}"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding InlineSummary}"
                                   Margin="6,4"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="6" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="审阅状态:" Style="{StaticResource FormLabelStyle}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ReviewStatusOptions}"
                      SelectedItem="{Binding SelectedReviewStatus}"
                      Style="{StaticResource ComboBoxStyle}" />
        </Grid>

        <Grid Grid.Row="7" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="备注:" Margin="0,0,0,6" Style="{StaticResource FormLabelStyle}" />
            <Border Grid.Row="1" BorderBrush="#CDCDCD" BorderThickness="1">
                <TextBox Text="{Binding CurrentNotes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="52"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource MultiLineTextBoxStyle}" />
            </Border>
        </Grid>

        <Border Grid.Row="8" BorderBrush="#CDCDCD" BorderThickness="1" Margin="0,0,0,8">
            <TextBox Text="{Binding LogContent, Mode=OneWay}"
                     BorderThickness="0"
                     IsReadOnly="True"
                     VerticalAlignment="Stretch"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource LogTextBoxStyle}" />
        </Border>

        <Border Grid.Row="9"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0">
            <Grid>
                <Button Content="设置"
                        Width="70"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenSettingsCommand}"
                        HorizontalAlignment="Left" />
                <Button Content="?"
                        Width="22"
                        Height="22"
                        Margin="78,0,0,0"
                        Style="{StaticResource HelpButtonStyle}"
                        Command="{Binding ShowHelpCommand}"
                        HorizontalAlignment="Left" />

                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="120,0,120,0"
                           TextWrapping="Wrap" />

                <ProgressBar Width="90"
                             Height="6"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Style="{StaticResource ProgressBarStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
