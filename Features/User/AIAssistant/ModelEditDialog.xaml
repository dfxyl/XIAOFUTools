<controls:ProWindow x:Class="XIAOFUTools.Features.User.AIAssistant.ModelEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="模型配置" 
        Height="570" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <controls:ProWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XIAOFUTools;component/Shared/Presentation/Styles/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </controls:ProWindow.Resources>
    
    <Grid Background="#f9fafb">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2563eb" Padding="20,16">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="添加模型" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="配置兼容 OpenAI 接口的模型" FontSize="11" Foreground="#bfdbfe" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- 显示名称 -->
                <TextBlock Text="显示名称 *" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>
                
                <!-- API 端点 -->
                <TextBlock Text="API 端点 *" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtEndpoint" Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"
                         Text="https://api.openai.com/v1"/>
                <TextBlock Text="例如: https://api.openai.com/v1" Foreground="#9ca3af" FontSize="10" Margin="0,0,0,16"/>
                
                <!-- 模型ID -->
                <TextBlock Text="模型 ID *" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtModelId" Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>
                <TextBlock Text="例如: gpt-4o, claude-3-opus" Foreground="#9ca3af" FontSize="10" Margin="0,0,0,16"/>
                
                <!-- API 密钥 -->
                <TextBlock Text="API 密钥（本地模型可不填）" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtApiKey" Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>
                <TextBlock Text="如使用 Ollama 等本地模型，可留空或填写任意值" Foreground="#9ca3af" FontSize="10" Margin="0,0,0,16"/>
                
                <!-- 最大Token -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="最大 Tokens" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtMaxTokens" Style="{StaticResource ModernTextBox}" Text="4096"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Temperature" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtTemperature" Style="{StaticResource ModernTextBox}" Text="0.7"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="上下文 Tokens" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtContextWindowTokens" Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>
                <TextBlock Text="留空时，已知内置模型会自动使用模型目录中的上下文长度" Foreground="#9ca3af" FontSize="10" Margin="0,0,0,16"/>
                
                <!-- 视觉模型 -->
                <CheckBox x:Name="chkVision" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="支持图片/视觉功能" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
                <TextBlock Text="勾选此项表示该模型支持图片输入（如 GPT-4o、Claude 3 等）" 
                           Foreground="#9ca3af" FontSize="10" Margin="20,0,0,0"/>
                
                <!-- API 连通性测试 -->
                <Border Background="#f8fafc" CornerRadius="6" Padding="12" Margin="0,16,0,0" BorderBrush="#e2e8f0" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="连通性测试" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0"/>
                            <Button x:Name="btnTestApi" Grid.Column="1" Content="测试连接" Style="{StaticResource SecondaryButton}" 
                                    Click="BtnTestApi_Click" Padding="12,6"/>
                        </Grid>
                        <TextBlock x:Name="txtTestResult" Text="" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#e5e7eb" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</controls:ProWindow>
