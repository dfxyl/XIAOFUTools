<Window x:Class="XIAOFUTools.Features.Custom.GisToolPocket.Presentation.ToolboxDonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="赞赏支持"
        Width="340"
        Height="410"
        MinWidth="320"
        MinHeight="380"
        MaxWidth="420"
        MaxHeight="520"
        Background="#ECEFF2"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Border Margin="10"
            Padding="14"
            Background="White"
            BorderBrush="#C9D1D9"
            BorderThickness="1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="赞赏支持"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#22272E"
                           HorizontalAlignment="Center" />
                <TextBlock Text="GIS 工具口袋会持续免费使用。"
                           FontSize="12"
                           Foreground="#68717D"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <TextBlock Text="如果这个小工具节省了你的时间，欢迎随手赞赏一杯咖啡。您的支持会用于后续维护、适配和功能更新。"
                           FontSize="12"
                           Foreground="#68717D"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button DockPanel.Dock="Bottom"
                    Content="关闭"
                    Width="76"
                    Height="28"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"
                    IsCancel="True"
                    Click="CloseButton_Click" />

            <Border Background="#F7F9FB"
                    BorderBrush="#D8DEE6"
                    BorderThickness="1"
                    Padding="10">
                <Image x:Name="DonationImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DockPanel>
    </Border>
</Window>

