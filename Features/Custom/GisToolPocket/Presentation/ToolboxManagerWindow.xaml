<Window x:Class="XIAOFUTools.Features.Custom.GisToolPocket.Presentation.ToolboxManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XIAOFUTools.Features.Custom.GisToolPocket.Presentation"
        Title="GIS 工具口袋管理"
        Width="940"
        Height="560"
        MinWidth="820"
        MinHeight="500"
        Background="#ECEFF2"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F5F7F9" />
        <SolidColorBrush x:Key="SurfaceHeaderBrush" Color="#EDF1F5" />
        <SolidColorBrush x:Key="LineBrush" Color="#C9D1D9" />
        <SolidColorBrush x:Key="LineStrongBrush" Color="#96A2AE" />
        <SolidColorBrush x:Key="TextBrush" Color="#22272E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#68717D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0079C1" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#168DD2" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7F2FA" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
        <SolidColorBrush x:Key="HiddenBrush" Color="#7A8793" />
        <SolidColorBrush x:Key="HiddenSurfaceBrush" Color="#F0F2F4" />

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CountPillStyle" TargetType="Border">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="VisibilityGlyphStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource HiddenBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="SourceTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SourceMetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E1E7ED" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolboxListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ToolboxListItem_PreviewMouseRightButtonDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9ECBE6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ToolTreeItem_PreviewMouseRightButtonDown" />
        </Style>

        <DataTemplate x:Key="SourceCatalogTemplate">
            <Grid MinHeight="54">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2"
                        Style="{StaticResource BadgeStyle}"
                        Background="{StaticResource AccentBrush}">
                    <TextBlock Text="源"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource SourceTitleTextStyle}"
                           Text="{Binding DisplayTitle}" />

                <Border Grid.Column="2"
                        Style="{StaticResource CountPillStyle}"
                        Margin="8,0,0,0">
                    <TextBlock Style="{StaticResource LabelTextStyle}"
                               Text="{Binding Summary}" />
                </Border>

                <TextBlock Grid.Column="3"
                           Style="{StaticResource VisibilityGlyphStyle}"
                           Text="{Binding IsVisible, Converter={x:Static local:ToolboxVisibilityGlyphConverter.Instance}}"
                           ToolTip="{Binding IsVisible, Converter={x:Static local:ToolboxVisibilityTooltipConverter.Instance}}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Margin="0,4,0,0"
                           Style="{StaticResource SourceMetaTextStyle}"
                           Text="{Binding SourceFileName}"
                           ToolTip="{Binding OriginalToolboxPath}" />

                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          Grid.ColumnSpan="3"
                          Margin="0,7,0,0"
                          SelectedValue="{Binding MenuMode, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="继承全局" Tag="Inherit" />
                    <ComboBoxItem Content="自动" Tag="Auto" />
                    <ComboBoxItem Content="按工具箱" Tag="Toolbox" />
                    <ComboBoxItem Content="按工具集" Tag="Toolset" />
                    <ComboBoxItem Content="完整目录" Tag="Tree" />
                    <ComboBoxItem Content="平铺工具" Tag="Flat" />
                </ComboBox>
            </Grid>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type local:ToolboxTreeNode}"
                                  ItemsSource="{Binding Children}">
            <Grid MinHeight="25" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource BadgeStyle}"
                        Margin="1,0,5,0"
                        Background="{Binding BadgeBrush}"
                        Opacity="{Binding NodeOpacity}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding EditableName}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12"
                           Opacity="{Binding NodeOpacity}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FullPath}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource VisibilityGlyphStyle}"
                           Text="{Binding VisibilityGlyph}"
                           ToolTip="{Binding VisibilityTooltip}"
                           Opacity="{Binding NodeOpacity}" />
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel Margin="8" LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Style="{StaticResource PanelStyle}"
                Padding="8,6"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GIS 工具口袋"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource CountPillStyle}" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource LabelTextStyle}"
                                   Text="{Binding ElementName=ToolboxList, Path=Items.Count, StringFormat=来源 {0}}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="菜单"
                               Style="{StaticResource LabelTextStyle}"
                               Margin="0,0,6,0" />
                    <ComboBox x:Name="MenuModeCombo"
                              Width="118"
                              SelectionChanged="MenuModeCombo_SelectionChanged">
                        <ComboBoxItem Content="自动" Tag="Auto" />
                        <ComboBoxItem Content="按工具箱" Tag="Toolbox" />
                        <ComboBoxItem Content="按工具集" Tag="Toolset" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="?"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="使用帮助"
                            Click="HelpButton_Click" />
                    <Button Content="取消" Style="{StaticResource ButtonBaseStyle}" IsCancel="True" />
                    <Button Content="保存并同步" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource PanelStyle}"
                Padding="8,4"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="6"
                        Height="6"
                        Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,7,0" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="来源"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="+" Style="{StaticResource IconButtonStyle}" ToolTip="添加工具箱" Click="AddButton_Click" />
                                <Button Content="组" Style="{StaticResource IconButtonStyle}" ToolTip="新建组" Click="AddCustomGroupButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="ToolboxList"
                             Background="{StaticResource SurfaceBrush}"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ToolboxListItemStyle}"
                             ItemsSource="{Binding Toolboxes}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ToolboxList_SelectionChanged"
                             SelectionMode="Extended">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="添加工具箱..." Click="SourceAddToolboxMenuItem_Click" />
                                <MenuItem Header="新建组" Click="SourceAddGroupMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="导入整包..." Click="SourceImportPackageMenuItem_Click" />
                                <MenuItem Header="导出整包..." Click="SourceExportPackageMenuItem_Click" />
                                <MenuItem Header="全部刷新" Click="SourceReloadAllMenuItem_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <StaticResource ResourceKey="SourceCatalogTemplate" />
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True" />

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TreeTitleText"
                                           Text="结构树"
                                           Style="{StaticResource PanelTitleTextStyle}" />
                                <Border Style="{StaticResource CountPillStyle}" Margin="8,0,0,0">
                                    <TextBlock x:Name="TreeHintText"
                                               Style="{StaticResource LabelTextStyle}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="展开" Style="{StaticResource ButtonBaseStyle}" Click="ExpandTreeButton_Click" />
                                <Button Content="折叠" Style="{StaticResource ButtonBaseStyle}" Click="CollapseTreeButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="类型" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="SelectedNodeTypeText"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="-" />
                            <TextBlock Grid.Column="2" Text="路径" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="SelectedNodePathText"
                                       Grid.Column="3"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="-" />
                            <TextBlock x:Name="SelectedNodeNameText" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceHeaderBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称"
                                       Style="{StaticResource LabelTextStyle}"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <TreeView x:Name="ToolTree"
                              Margin="6"
                              AllowDrop="True"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource TreeItemStyle}"
                              ItemsSource="{Binding TreeNodes}"
                              PreviewMouseLeftButtonDown="ToolTree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="ToolTree_PreviewMouseMove"
                              DragOver="ToolTree_DragOver"
                              Drop="ToolTree_Drop"
                              DragLeave="ToolTree_DragLeave"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="ToolTree_SelectedItemChanged" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
