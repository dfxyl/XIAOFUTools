          <button refID="XIAOFUTools_HistoricalImageryButton" />
          <buttonPalette refID="XIAOFUTools_CommonButtonPalette" />
        </group>
        <group id="XIAOFUTools_EditGroup" caption="编辑" appearsOnAddInTab="false">
          <tool refID="XIAOFUTools_AreaSplitTool" />
