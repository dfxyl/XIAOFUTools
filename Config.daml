      <controls>
        <button id="GIS_Toolbox_SettingsButton"
                caption="管理"
                className="XIAOFUTools.Features.Custom.GisToolPocket.Presentation.ToolboxSettingsButton"
                loadOnClick="true"
                smallImage="Assets\Images\GisToolPocket\Settings16.png"
                largeImage="Assets\Images\GisToolPocket\Settings32.png">
          <tooltip heading="GIS 工具口袋管理">
            添加、移除、刷新 ArcGIS Pro 工具、命令和自定义工具箱
            <disabledText>当前状态不可用</disabledText>
          </tooltip>
        </button>

        <customControl id="GIS_Toolbox_ToolSearchControl"
                       caption="搜索工具"
                       className="XIAOFUTools.Features.Custom.GisToolPocket.Presentation.ToolboxSearchControl"
                       loadOnClick="false"
                       keytip="S"
                       smallImage="Assets\Images\GisToolPocket\ToolKind16.png"
                       largeImage="Assets\Images\GisToolPocket\ToolKind32.png">
          <tooltip heading="搜索工具">
            搜索已添加到 GIS 工具口袋的工具，回车或选择结果即可打开。
