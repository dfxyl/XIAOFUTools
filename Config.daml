        </button>
        <!-- 镜像数据库按钮 -->
        <button id="XIAOFUTools_MirrorDatabaseButton" caption="镜像数据库" className="XIAOFUTools.Tools.DataProcessing.MirrorDatabase.MirrorDatabaseButton" loadOnClick="true" smallImage="Images\MirrorDatabase_16.png" largeImage="Images\MirrorDatabase_32.png">
          <tooltip heading="镜像数据库">
            将源数据库的结构（要素集、要素类、表）镜像到新数据库，只复制结构不复制数据
            <disabledText>无权限使用镜像数据库功能</disabledText></tooltip>
        </button>
        <!-- 输出数据库属性结构表按钮 -->
        <button id="XIAOFUTools_ExportDatabaseSchemaButton" caption="输出数据库属性结构表" className="XIAOFUTools.Tools.DataProcessing.ExportDatabaseSchema.ExportDatabaseSchemaButton" loadOnClick="true" smallImage="Images\ExportDatabaseSchema_16.png" largeImage="Images\ExportDatabaseSchema_32.png">
          <tooltip heading="输出数据库属性结构表">
            将文件地理数据库的属性结构导出为Excel文件
            <disabledText>无权限使用输出数据库属性结构表功能</disabledText></tooltip>
        </button>
        <!-- 驱动制图按钮 -->
        <button id="XIAOFUTools_MapSeriesExportButton" caption="驱动制图" className="XIAOFUTools.Tools.Output.MapSeriesExport.MapSeriesExportButton" loadOnClick="true" smallImage="Images\MapSeriesExport_16.png" largeImage="Images\MapSeriesExport_32.png">
          <tooltip heading="驱动制图">
            基于地图系列批量导出布局页面，支持PDF、JPG、PNG、TIF格式
            <disabledText>无权限使用驱动制图功能</disabledText></tooltip>
        </button>
        <!-- 开发区整合优化核查按钮 -->
        <button id="XIAOFUTools_DevZoneCheckButton" caption="开发区整合优化核查(定制)" className="XIAOFUTools.Tools.User.Custom.DevZoneCheck.DevZoneCheckButton" loadOnClick="true" smallImage="Images\DevZoneCheck_16.png" largeImage="Images\DevZoneCheck_32.png">
          <tooltip heading="开发区整合优化核查(定制)">
            基于园区红线进行底线类、节约集约类、发展空间类核查分析，所有面积基于椭球面计算
            <disabledText>无权限使用开发区整合优化核查功能</disabledText></tooltip>
        </button>
        <!-- 此处可添加其他工具按钮 -->
      </controls>
      <menus>
        <!-- 匹配符号菜单 -->
        <menu id="XIAOFUTools_MatchSymbologyMenu" caption="匹配符号" smallImage="Images\MatchSymbology_16.png" largeImage="Images\MatchSymbology_32.png">
          <button refID="XIAOFUTools_MatchSymbologyButton" />
          <button refID="XIAOFUTools_MatchSymbologyDLMCButton" />
          <button refID="XIAOFUTools_MatchSymbologyDLBMButton" />
          <button refID="XIAOFUTools_MatchSymbologyFXDLMCButton" />
          <button refID="XIAOFUTools_MatchSymbologyFXDLBMButton" />
          <button refID="XIAOFUTools_MatchSymbologyBZKJDLMCButton" />
          <button refID="XIAOFUTools_MatchSymbologyBZKJDLBMButton" />
          <button refID="XIAOFUTools_MatchSymbologyYDYHFLDMButton" />
          <button refID="XIAOFUTools_MatchSymbologyYDYHFLMCButton" />
        </menu>
      </menus>
    </insertModule>
    <!-- ============================== 菜单定义 ============================== -->
    <updateModule refID="esri_mapping">
      <menus>
        <!-- 图层的右键菜单 -->
        <updateMenu refID="esri_mapping_layerContextMenu">
          <insertButton refID="XIAOFUTools_AreaCalculatorButton" insert="before" placeWith="esri_editing_table_openTablePaneButton" separator="true" />
          <insertMenu refID="XIAOFUTools_MatchSymbologyMenu" insert="after" placeWith="esri_mapping_selectedLayerSymbologyButton" separator="false" />
          <insertButton refID="XIAOFUTools_PasteSymbologyButton" insert="after" placeWith="esri_mapping_selectedLayerSymbologyButton" separator="false" />
          <!-- 在此添加图层右键菜单项 -->
        </updateMenu>
        <!-- 图层的右键菜单 (SHP等未注册图层) -->
        <updateMenu refID="esri_mapping_unregisteredLayerContextMenu">
          <insertButton refID="XIAOFUTools_AreaCalculatorButton" insert="before" placeWith="esri_editing_table_openTablePaneButton" separator="true" />
          <insertMenu refID="XIAOFUTools_MatchSymbologyMenu" insert="after" placeWith="esri_mapping_selectedLayerSymbologyButton" separator="false" />
          <insertButton refID="XIAOFUTools_PasteSymbologyButton" insert="after" placeWith="esri_mapping_selectedLayerSymbologyButton" separator="false" />
          <!-- 在此添加未注册图层右键菜单项 -->
        </updateMenu>
        <!-- 图层组的右键菜单 -->
        <updateMenu refID="esri_mapping_groupLayerContextMenu">
          <!-- 在此添加图层组右键菜单项 -->
        </updateMenu>
        <!-- 独立表的右键菜单 -->
        <updateMenu refID="esri_mapping_standaloneTableContextMenu">
          <!-- 在此添加独立表右键菜单项 -->
        </updateMenu>
        <!-- 栅格图层的右键菜单 -->
        <updateMenu refID="esri_mapping_rasterLayerContextMenu">
          <!-- 在此添加栅格图层右键菜单项 -->
        </updateMenu>
        <!-- 地图列表的右键菜单 -->
        <updateMenu refID="esri_mapping_mapContextMenu">
          <insertGallery refID="XIAOFUTools_PresetLayersGallery" insert="before" placeWith="esri_mapping_addDataButton" separator="true" />
          <insertButton refID="XIAOFUTools_BatchAddDataButton" insert="before" placeWith="esri_mapping_addDataButton" separator="false" />
          <!-- 在此添加地图右键菜单项 -->
        </updateMenu>
        <!-- 地图视图的右键菜单 -->
        <updateMenu refID="esri_mapping_popupToolContextMenu">
          <insertGallery refID="XIAOFUTools_PresetLayersGallery" insert="before" placeWith="esri_core_editPasteButton" separator="true" />
          <insertButton refID="XIAOFUTools_BatchAddDataButton" insert="before" placeWith="esri_core_editPasteButton" separator="false" />
          <!-- 在此添加地图视图右键菜单项 -->
        </updateMenu>
        <!-- 地图视图内选择的右键菜单 -->
        <updateMenu refID="esri_mapping_selection2DContextMenu">
          <insertButton refID="XIAOFUTools_ViewAreaButton" insert="before" placeWith="esri_core_editCopyButton" separator="true" />
          <insertGallery refID="XIAOFUTools_PresetLayersGallery" insert="before" placeWith="esri_core_editCopyButton" separator="false" />
          <!-- 在此添加更多选择右键菜单项 -->
        </updateMenu>
      </menus>
      <groups>
        <!-- 图层工具组更新 -->
        <updateGroup refID="esri_mapping_layerGroup">
          <insertGallery refID="XIAOFUTools_PresetLayersGallery" size="large" placeWith="esri_mapping_addDataSplitButton" insert="before" />
        </updateGroup>
        <!-- 数据工具组更新 -->
        <updateGroup refID="esri_mapping_layerToolsGroup">
          <insertButton refID="XIAOFUTools_ExportCADButton" insert="after" placeWith="esri_editing_tableExportTableButton" separator="true" />
          <insertButton refID="XIAOFUTools_ExportExcelButton" insert="after" placeWith="XIAOFUTools_ExportCADButton" separator="false" />
        </updateGroup>
      </groups>
    </updateModule>
    <!-- 编辑模块菜单定义 -->
    <updateModule refID="esri_editing_EditingModule">
      <menus>
        <!-- 要素图层数据菜单 -->
        <updateMenu refID="esri_editing_data">
          <insertButton refID="XIAOFUTools_ExportCADButton" insert="after" placeWith="esri_editing_tableExportTableButton" separator="true" />
          <insertButton refID="XIAOFUTools_ExportExcelButton" insert="after" placeWith="XIAOFUTools_ExportCADButton" separator="false" />
          <!-- 在此添加要素图层数据菜单项 -->
        </updateMenu>
        <!-- 独立表数据菜单 -->
        <updateMenu refID="esri_editing_standalonetable_data_menu">
          <insertButton refID="XIAOFUTools_ExportExcelButton" insert="after" placeWith="esri_editing_tableExportTableButton" separator="false" />
          <!-- 在此添加独立表数据菜单项 -->
        </updateMenu>
      </menus>
    </updateModule>
  </modules>
</ArcGIS>
