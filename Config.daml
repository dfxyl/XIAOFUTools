        <!-- 生成四至坐标点停靠窗格 -->
        <dockPane id="XIAOFUTools_BoundaryPointGeneratorDockPane" caption="生成四至坐标点" className="XIAOFUTools.Features.DataManagement.BoundaryPointGenerator.BoundaryPointGeneratorDockPane" dock="group" dockWith="esri_core_projectDockPane"></dockPane>
        <!-- 地块中文编号停靠窗格 -->
