            根据FXDLBM字段匹配地类符号
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- BZKJDLMC匹配符号按钮 -->
        <button id="XIAOFUTools_MatchSymbologyBZKJDLMCButton" caption="BZKJDLMC匹配符号" className="XIAOFUTools.Features.Editing.MatchSymbology.MatchSymbologyBZKJDLMCButton" loadOnClick="true" smallImage="Assets\Images\MatchSymbology_16.png" largeImage="Assets\Images\MatchSymbology_32.png">
          <tooltip heading="BZKJDLMC匹配符号">
            根据BZKJDLMC字段匹配地类符号
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- BZKJDLBM匹配符号按钮 -->
        <button id="XIAOFUTools_MatchSymbologyBZKJDLBMButton" caption="BZKJDLBM匹配符号" className="XIAOFUTools.Features.Editing.MatchSymbology.MatchSymbologyBZKJDLBMButton" loadOnClick="true" smallImage="Assets\Images\MatchSymbology_16.png" largeImage="Assets\Images\MatchSymbology_32.png">
          <tooltip heading="BZKJDLBM匹配符号">
            根据BZKJDLBM字段匹配地类符号
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- YDYHFLDM匹配国空符号按钮 -->
        <button id="XIAOFUTools_MatchSymbologyYDYHFLDMButton" caption="YDYHFLDM匹配国空符号" className="XIAOFUTools.Features.Editing.MatchSymbology.MatchSymbologyYDYHFLDMButton" loadOnClick="true" smallImage="Assets\Images\MatchSymbology_16.png" largeImage="Assets\Images\MatchSymbology_32.png">
          <tooltip heading="YDYHFLDM匹配国空符号">
            根据YDYHFLDM字段匹配国空符号
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- YDYHFLMC匹配国空符号按钮 -->
        <button id="XIAOFUTools_MatchSymbologyYDYHFLMCButton" caption="YDYHFLMC匹配国空符号" className="XIAOFUTools.Features.Editing.MatchSymbology.MatchSymbologyYDYHFLMCButton" loadOnClick="true" smallImage="Assets\Images\MatchSymbology_16.png" largeImage="Assets\Images\MatchSymbology_32.png">
          <tooltip heading="YDYHFLMC匹配国空符号">
            根据YDYHFLMC字段匹配国空符号
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 属性表建库按钮 -->
        <button id="XIAOFUTools_DatabaseBuilderButton" caption="属性表建库" className="XIAOFUTools.Features.DataManagement.DatabaseBuilder.DatabaseBuilderButton" loadOnClick="true" smallImage="Assets\Images\DatabaseBuilder_16.png" largeImage="Assets\Images\DatabaseBuilder_32.png">
          <tooltip heading="属性表建库">
            根据Excel属性结构表自动创建文件地理数据库及要素类
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 属性表建SHP按钮 -->
        <button id="XIAOFUTools_ShapefileBuilderButton" caption="属性表建SHP" className="XIAOFUTools.Features.DataManagement.ShapefileBuilder.ShapefileBuilderButton" loadOnClick="true" smallImage="Assets\Images\ShapefileBuilder_16.png" largeImage="Assets\Images\ShapefileBuilder_32.png">
          <tooltip heading="属性表建SHP">
            根据Excel属性结构表批量创建Shapefile
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- SHP输字段表按钮 -->
        <button id="XIAOFUTools_ExportShpFieldTableButton" caption="SHP输字段表" className="XIAOFUTools.Features.DataManagement.ExportShpFieldTable.ExportShpFieldTableButton" loadOnClick="true" smallImage="Assets\Images\ExportShpFieldTable_16.png" largeImage="Assets\Images\ExportShpFieldTable_32.png">
          <tooltip heading="SHP输字段表">
            将输入目录中的SHP字段结构导出为Excel表
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 批量合并SHP按钮 -->
        <button id="XIAOFUTools_BatchMergeShpButton" caption="批量合并SHP" className="XIAOFUTools.Features.DataManagement.BatchMergeShp.BatchMergeShpButton" loadOnClick="true" smallImage="Assets\Images\BatchMergeShp_16.png" largeImage="Assets\Images\BatchMergeShp_32.png">
          <tooltip heading="批量合并SHP">
            选择文件夹后自动遍历SHP并批量合并，支持子文件夹扫描与源文件名字段写入
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- MDB批量格式转换按钮 -->
        <button id="XIAOFUTools_MdbBatchToGdbButton" caption="MDB批量格式转换" className="XIAOFUTools.Features.DataManagement.MdbBatchToGdb.MdbBatchToGdbButton" loadOnClick="true" smallImage="Assets\Images\MdbBatchToGdb_16.png" largeImage="Assets\Images\MdbBatchToGdb_32.png">
          <tooltip heading="MDB批量格式转换">
            扫描文件夹中的MDB并按勾选项批量转换为GDB，支持输出到源路径或指定目录
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 镜像数据库按钮 -->
        <button id="XIAOFUTools_MirrorDatabaseButton" caption="镜像数据库" className="XIAOFUTools.Features.DataManagement.MirrorDatabase.MirrorDatabaseButton" loadOnClick="true" smallImage="Assets\Images\MirrorDatabase_16.png" largeImage="Assets\Images\MirrorDatabase_32.png">
          <tooltip heading="镜像数据库">
            将源数据库的结构（要素集、要素类、表）镜像到新数据库，只复制结构不复制数据
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 输出数据库属性结构表按钮 -->
        <button id="XIAOFUTools_ExportDatabaseSchemaButton" caption="输出数据库属性结构表" className="XIAOFUTools.Features.DataManagement.ExportDatabaseSchema.ExportDatabaseSchemaButton" loadOnClick="true" smallImage="Assets\Images\ExportDatabaseSchema_16.png" largeImage="Assets\Images\ExportDatabaseSchema_32.png">
          <tooltip heading="输出数据库属性结构表">
            将文件地理数据库的属性结构导出为Excel文件
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 地类表按钮 -->
        <button id="XIAOFUTools_LandClassTableButton" caption="分析地类输出地类表" className="XIAOFUTools.Features.Analysis.LandClassTable.LandClassTableButton" loadOnClick="true" smallImage="Assets\Images\ExportExcel_16.png" largeImage="Assets\Images\ExportExcel_32.png">
          <tooltip heading="分析地类输出地类表">
            按项目红线与地类图斑叠加生成地类表
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 驱动制图按钮 -->
        <button id="XIAOFUTools_MapSeriesExportButton" caption="驱动制图" className="XIAOFUTools.Features.Cartography.MapSeriesExport.MapSeriesExportButton" loadOnClick="true" smallImage="Assets\Images\MapSeriesExport_16.png" largeImage="Assets\Images\MapSeriesExport_32.png">
          <tooltip heading="驱动制图">
            基于地图系列批量导出布局页面，支持PDF、JPG、PNG、TIF格式
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 开发区整合优化核查按钮 -->
        <button id="XIAOFUTools_DevZoneCheckButton" caption="开发区整合优化核查(定制)" className="XIAOFUTools.Features.Custom.DevZoneCheck.DevZoneCheckButton" loadOnClick="true" smallImage="Assets\Images\DevZoneCheck_16.png" largeImage="Assets\Images\DevZoneCheck_32.png">
          <tooltip heading="开发区整合优化核查(定制)">
            基于园区红线进行底线类、节约集约类、发展空间类核查分析，所有面积基于椭球面计算
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 此处可添加其他工具按钮 -->
      </controls>
      <menus>
        <!-- 匹配符号菜单 -->
        <menu id="XIAOFUTools_MatchSymbologyMenu" caption="匹配符号" smallImage="Assets\Images\MatchSymbology_16.png" largeImage="Assets\Images\MatchSymbology_32.png">
          <button refID="XIAOFUTools_MatchSymbologyButton" />
          <button refID="XIAOFUTools_MatchSymbologyDLMCButton" />
          <button refID="XIAOFUTools_MatchSymbologyDLBMButton" />
          <button refID="XIAOFUTools_MatchSymbologyFXDLMCButton" />
          <button refID="XIAOFUTools_MatchSymbologyFXDLBMButton" />
          <button refID="XIAOFUTools_MatchSymbologyBZKJDLMCButton" />
          <button refID="XIAOFUTools_MatchSymbologyBZKJDLBMButton" />
          <button refID="XIAOFUTools_MatchSymbologyYDYHFLDMButton" />
          <button refID="XIAOFUTools_MatchSymbologyYDYHFLMCButton" />
        </menu>
      </menus>
    </insertModule>
    <!-- ============================== 菜单定义 ============================== -->
    <updateModule refID="esri_mapping">
      <menus>
        <!-- 图层的右键菜单 -->
        <updateMenu refID="esri_mapping_layerContextMenu">
          <insertButton refID="XIAOFUTools_AreaCalculatorButton" insert="before" placeWith="esri_editing_table_openTablePaneButton" separator="true" />
          <insertMenu refID="XIAOFUTools_MatchSymbologyMenu" insert="after" placeWith="esri_mapping_selectedLayerSymbologyButton" separator="false" />
          <insertButton refID="XIAOFUTools_PasteSymbologyButton" insert="after" placeWith="esri_mapping_selectedLayerSymbologyButton" separator="false" />
          <!-- 在此添加图层右键菜单项 -->
        </updateMenu>
        <!-- 图层的右键菜单 (SHP等未注册图层) -->
        <updateMenu refID="esri_mapping_unregisteredLayerContextMenu">
          <insertButton refID="XIAOFUTools_AreaCalculatorButton" insert="before" placeWith="esri_editing_table_openTablePaneButton" separator="true" />
          <insertMenu refID="XIAOFUTools_MatchSymbologyMenu" insert="after" placeWith="esri_mapping_selectedLayerSymbologyButton" separator="false" />
          <insertButton refID="XIAOFUTools_PasteSymbologyButton" insert="after" placeWith="esri_mapping_selectedLayerSymbologyButton" separator="false" />
          <!-- 在此添加未注册图层右键菜单项 -->
        </updateMenu>
        <!-- 图层组的右键菜单 -->
        <updateMenu refID="esri_mapping_groupLayerContextMenu">
          <!-- 在此添加图层组右键菜单项 -->
        </updateMenu>
        <!-- 独立表的右键菜单 -->
        <updateMenu refID="esri_mapping_standaloneTableContextMenu">
          <!-- 在此添加独立表右键菜单项 -->
        </updateMenu>
        <!-- 栅格图层的右键菜单 -->
        <updateMenu refID="esri_mapping_rasterLayerContextMenu">
          <!-- 在此添加栅格图层右键菜单项 -->
        </updateMenu>
        <!-- 地图列表的右键菜单 -->
        <updateMenu refID="esri_mapping_mapContextMenu">
          <insertGallery refID="XIAOFUTools_PresetLayersGallery" insert="before" placeWith="esri_mapping_addDataButton" separator="true" />
          <insertButton refID="XIAOFUTools_BatchAddDataButton" insert="before" placeWith="esri_mapping_addDataButton" separator="false" />
          <!-- 在此添加地图右键菜单项 -->
        </updateMenu>
        <!-- 地图视图的右键菜单 -->
        <updateMenu refID="esri_mapping_popupToolContextMenu">
          <insertGallery refID="XIAOFUTools_PresetLayersGallery" insert="before" placeWith="esri_core_editPasteButton" separator="true" />
          <insertButton refID="XIAOFUTools_BatchAddDataButton" insert="before" placeWith="esri_core_editPasteButton" separator="false" />
          <!-- 在此添加地图视图右键菜单项 -->
        </updateMenu>
        <!-- 地图视图内选择的右键菜单 -->
        <updateMenu refID="esri_mapping_selection2DContextMenu">
          <insertButton refID="XIAOFUTools_ViewAreaButton" insert="before" placeWith="esri_core_editCopyButton" separator="true" />
          <insertGallery refID="XIAOFUTools_PresetLayersGallery" insert="before" placeWith="esri_core_editCopyButton" separator="false" />
          <!-- 在此添加更多选择右键菜单项 -->
        </updateMenu>
      </menus>
      <groups>
        <!-- 图层工具组更新 -->
        <updateGroup refID="esri_mapping_layerGroup">
          <insertGallery refID="XIAOFUTools_PresetLayersGallery" size="large" placeWith="esri_mapping_addDataSplitButton" insert="before" />
        </updateGroup>
        <!-- 数据工具组更新 -->
        <updateGroup refID="esri_mapping_layerToolsGroup">
          <insertButton refID="XIAOFUTools_ExportCADButton" insert="after" placeWith="esri_editing_tableExportTableButton" separator="true" />
          <insertButton refID="XIAOFUTools_ExportExcelButton" insert="after" placeWith="XIAOFUTools_ExportCADButton" separator="false" />
        </updateGroup>
      </groups>
    </updateModule>
    <!-- 编辑模块菜单定义 -->
    <updateModule refID="esri_editing_EditingModule">
      <menus>
        <!-- 要素图层数据菜单 -->
        <updateMenu refID="esri_editing_data">
          <insertButton refID="XIAOFUTools_ExportCADButton" insert="after" placeWith="esri_editing_tableExportTableButton" separator="true" />
          <insertButton refID="XIAOFUTools_ExportExcelButton" insert="after" placeWith="XIAOFUTools_ExportCADButton" separator="false" />
          <!-- 在此添加要素图层数据菜单项 -->
        </updateMenu>
        <!-- 独立表数据菜单 -->
        <updateMenu refID="esri_editing_standalonetable_data_menu">
          <insertButton refID="XIAOFUTools_ExportExcelButton" insert="after" placeWith="esri_editing_tableExportTableButton" separator="false" />
          <!-- 在此添加独立表数据菜单项 -->
        </updateMenu>
      </menus>
    </updateModule>
