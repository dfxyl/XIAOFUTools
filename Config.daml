      <!-- ============================== 控件定义（最底层） ============================== -->
      <controls>
        <!-- 批量添加数据按钮 -->
        <button id="XIAOFUTools_QuickAddDataButton" caption="快捷添加数据" className="XIAOFUTools.Features.General.QuickAddData.QuickAddDataButton" loadOnClick="true" smallImage="Assets\Images\QuickAddData_16.png" largeImage="Assets\Images\QuickAddData_32.png">
          <tooltip heading="快捷添加数据">
            长期保存快捷数据，按分组管理并批量加载到地图
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <button id="XIAOFUTools_BatchAddDataButton" caption="批量添加数据" className="XIAOFUTools.Features.DataManagement.BatchAddData.BatchAddDataButton" loadOnClick="true" smallImage="Assets\Images\BatchAddData_16.png" largeImage="Assets\Images\BatchAddData_32.png">
          <tooltip heading="批量添加数据">
            扫描文件夹中的GIS数据并批量添加到地图
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 分组编号按钮 -->
        <button id="XIAOFUTools_GroupNumberingButton" caption="要素顺序编号" className="XIAOFUTools.Features.Editing.GroupNumbering.GroupNumberingButton" loadOnClick="true" smallImage="Assets\Images\GroupNumbering_16.png" largeImage="Assets\Images\GroupNumbering_32.png">
          <tooltip heading="要素顺序编号">
            按指定分组字段对要素进行顺序编号
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 地块中文编号按钮 -->
        <button id="XIAOFUTools_ChineseNumberingButton" caption="地块中文编号" className="XIAOFUTools.Features.Editing.ChineseNumbering.ChineseNumberingButton" loadOnClick="true" smallImage="Assets\Images\ChineseNumbering_16.png" largeImage="Assets\Images\ChineseNumbering_32.png">
          <tooltip heading="地块中文编号">
            使用中文数字（一、二、三...）对要素进行编号
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 按字段批量裁剪按钮 -->
        <button id="XIAOFUTools_BatchLayerClipButton" caption="按字段批量裁剪要素" className="XIAOFUTools.Features.DataManagement.BatchLayerClip.BatchLayerClipButton" loadOnClick="true" smallImage="Assets\Images\BatchLayerClip_16.png" largeImage="Assets\Images\BatchLayerClip_32.png">
          <tooltip heading="按字段批量裁剪">
            根据字段值批量裁剪要素并导出为Shapefile
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 字段复制工具按钮 -->
        <button id="XIAOFUTools_FieldCopyToolButton" caption="字段复制工具" className="XIAOFUTools.Features.DataManagement.FieldCopyTool.FieldCopyToolButton" loadOnClick="true" smallImage="Assets\Images\FieldCopyTool_16.png" largeImage="Assets\Images\FieldCopyTool_32.png">
          <tooltip heading="字段复制工具">
            将源数据的字段复制到目标图层
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 根据范围批量裁剪要素图层按钮 -->
        <button id="XIAOFUTools_RangeClipToolButton" caption="根据范围批量裁剪要素图层" className="XIAOFUTools.Features.DataManagement.RangeClipTool.RangeClipToolButton" loadOnClick="true" smallImage="Assets\Images\RangeClipTool_16.png" largeImage="Assets\Images\RangeClipTool_32.png">
          <tooltip heading="根据范围批量裁剪要素图层">
            根据范围图层的字段值批量裁剪要素图层
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 生成四至坐标点按钮 -->
        <button id="XIAOFUTools_BoundaryPointGeneratorButton" caption="生成四至坐标点" className="XIAOFUTools.Features.DataManagement.BoundaryPointGenerator.BoundaryPointGeneratorButton" loadOnClick="true" smallImage="Assets\Images\BoundaryPointGenerator_16.png" largeImage="Assets\Images\BoundaryPointGenerator_32.png">
          <tooltip heading="生成四至坐标点">
            根据输入面要素生成四至坐标点（最东、最西、最南、最北点）
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 计算面积按钮 -->
        <button id="XIAOFUTools_AreaCalculatorButton" caption="计算面积" className="XIAOFUTools.Features.Analysis.AreaCalculator.AreaCalculatorButton" loadOnClick="true" smallImage="Assets\Images\AreaCalculator_16.png" largeImage="Assets\Images\AreaCalculator_32.png">
