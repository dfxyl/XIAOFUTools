  <modules>
    <insertModule id="XIAOFUTools_Module" className="Module1" autoLoad="true" caption="XIAOFU工具箱">
      <!-- ============================== 选项卡定义（最顶层） ============================== -->
      <tabs>
        <tab id="XIAOFUTools_Tab1" caption="XIAOFU工具箱" keytip="X">
          <group refID="XIAOFUTools_CommonGroup" />
          <group refID="XIAOFUTools_EditGroup" />
          <group refID="XIAOFUTools_DataProcessingGroup" />
          <group refID="XIAOFUTools_LayoutDocGroup" />
          <group refID="XIAOFUTools_UserGroup" />
          <group refID="XIAOFUTools_QuickAccessGroup" />
        </tab>
      </tabs>
      <!-- ============================== 分组定义（中间层） ============================== -->
      <groups>
        <group id="XIAOFUTools_CommonGroup" caption="通用" appearsOnAddInTab="false">
          <button refID="XIAOFUTools_ViewAreaButton" />
          <inlineGallery refID="XIAOFUTools_PresetLayersGallery" />
          <button refID="XIAOFUTools_HistoricalImageryButton" />
          <buttonPalette refID="XIAOFUTools_CommonButtonPalette" />
        </group>
        <group id="XIAOFUTools_EditGroup" caption="编辑" appearsOnAddInTab="false">
          <tool refID="XIAOFUTools_AreaSplitTool" />
          <buttonPalette refID="XIAOFUTools_EditButtonPalette" />
          <buttonPalette refID="XIAOFUTools_Common2ButtonPalette" />
          <buttonPalette refID="XIAOFUTools_BoundaryButtonPalette" />
          <buttonPalette refID="XIAOFUTools_DynamicToolsButtonPalette" />
        </group>
        <group id="XIAOFUTools_DataProcessingGroup" caption="数据" appearsOnAddInTab="false">
          <button refID="XIAOFUTools_AreaCalculatorButton" />
          <buttonPalette refID="XIAOFUTools_AnalysisButtonPalette" />
          <buttonPalette refID="XIAOFUTools_ConvertButtonPalette" />
          <buttonPalette refID="XIAOFUTools_DataProcessingToolsButtonPalette" />
        </group>
        <group id="XIAOFUTools_LayoutDocGroup" caption="制图" appearsOnAddInTab="false">
          <buttonPalette refID="XIAOFUTools_OutputButtonPalette" />
          <buttonPalette refID="XIAOFUTools_PdfButtonPalette" />
        </group>
        <group id="XIAOFUTools_UserGroup" caption="系统" appearsOnAddInTab="false">
          <button refID="XIAOFUTools_AIAssistantButton" />
          <buttonPalette refID="XIAOFUTools_CustomButtonPalette" />
          <buttonPalette refID="XIAOFUTools_UserConfigButtonPalette" />
        </group>
        <group id="XIAOFUTools_QuickAccessGroup" caption="ArcGIS常用" appearsOnAddInTab="false">
          <splitButton refID="esri_mapping_exploreSplitButton" />
          <splitButton refID="esri_editing_selectToolPalette" />
          <splitButton refID="esri_mapping_clearSelectionButton" />
          <splitButton refID="esri_reports_navigateContext" />
          <splitButton refID="esri_layouts_selectContext" />
          <splitButton refID="esri_mapping_measureSplitButton" />
        </group>
      </groups>
      <!-- ============================== 按钮面板定义（较低层） ============================== -->
      <palettes>
        <buttonPalette id="XIAOFUTools_CommonButtonPalette" caption="数据加载" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_QuickAddDataButton" />
          <button refID="XIAOFUTools_BatchAddDataButton" />
          <button refID="XIAOFUTools_HistoricalImageryDownloadButton" />
          <button refID="XIAOFUTools_InternetTileDownloadButton" />
          <button refID="XIAOFUTools_DownloadOnlineImageryButton" />
          <button refID="XIAOFUTools_OvertureLoaderButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_EditButtonPalette" caption="属性编辑" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_GroupNumberingButton" />
          <button refID="XIAOFUTools_ChineseNumberingButton" />
          <button refID="XIAOFUTools_FieldCopyToolButton" />
          <button refID="XIAOFUTools_AttributeTransferFieldsButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_Common2ButtonPalette" caption="几何编辑" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_BatchLayerClipButton" />
          <button refID="XIAOFUTools_RangeClipToolButton" />
          <button refID="XIAOFUTools_RotateGeometryButton" />
          <button refID="XIAOFUTools_BatchProjectionDefinitionButton" />
          <button refID="XIAOFUTools_BatchGeometryRepairButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_BoundaryButtonPalette" caption="界址编辑" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_BoundaryPointGeneratorButton" />
          <tool refID="XIAOFUTools_ViewStartPointTool" />
          <button refID="XIAOFUTools_ModifyStartPointButton" />
          <button refID="XIAOFUTools_BoundaryPointLineGeneratorButton" />
          <button refID="XIAOFUTools_MapBoundaryPointLineGeneratorButton" />
          <button refID="XIAOFUTools_ProtocolLineExtractButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_DynamicToolsButtonPalette" caption="界址成果" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_LayoutCoordinateTableButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_AnalysisButtonPalette" caption="分析检查" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_ExtractPolygonHolesButton" />
          <button refID="XIAOFUTools_IntersectSummaryButton" />
          <button refID="XIAOFUTools_MultiOverlaySummaryButton" />
          <button refID="XIAOFUTools_DataPivotButton" />
          <button refID="XIAOFUTools_BrowseFeaturesButton" />
          <button refID="XIAOFUTools_NodeDistanceCheckButton" />
          <button refID="XIAOFUTools_OverlapCheckButton" />
          <button refID="XIAOFUTools_GapCheckButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_ConvertButtonPalette" caption="格式转换" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_FeatureToTxtButton" />
          <button refID="XIAOFUTools_TxtToFeatureButton" />
          <button refID="XIAOFUTools_SpecialCoordinateTransformButton" />
          <button refID="XIAOFUTools_ExportToKmlButton" />
          <button refID="XIAOFUTools_PolygonToDwgWithFillButton" />
          <button refID="XIAOFUTools_PolygonToDxfWithFillButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_DataProcessingToolsButtonPalette" caption="数据整备" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_BatchMergeShpButton" />
          <button refID="XIAOFUTools_MdbBatchToGdbButton" />
          <button refID="XIAOFUTools_MirrorDatabaseButton" />
          <button refID="XIAOFUTools_DatabaseBuilderButton" />
          <button refID="XIAOFUTools_ShapefileBuilderButton" />
          <button refID="XIAOFUTools_ExportShpFieldTableButton" />
          <button refID="XIAOFUTools_ExportDatabaseSchemaButton" />
          <button refID="XIAOFUTools_LandClassTableButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_OutputButtonPalette" caption="布局图幅" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_MapSeriesExportButton" />
          <button refID="XIAOFUTools_ExportLayoutButton" />
          <button refID="XIAOFUTools_LayoutTextReplaceButton" />
          <button refID="XIAOFUTools_GenerateSmallMapSheetsButton" />
          <button refID="XIAOFUTools_SmallMapSheetAssignButton" />
          <button refID="XIAOFUTools_GenerateLargeMapSheetsButton" />
          <button refID="XIAOFUTools_LargeMapSheetAssignButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_PdfButtonPalette" caption="文档处理" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_PdfToImagesButton" />
          <button refID="XIAOFUTools_ImagesToPdfButton" />
          <button refID="XIAOFUTools_ExcelToPdfButton" />
          <button refID="XIAOFUTools_WordToPdfButton" />
          <button refID="XIAOFUTools_DocumentBatchReplaceButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_CustomButtonPalette" caption="定制" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_DevZoneCheckButton" />
        </buttonPalette>
        <buttonPalette id="XIAOFUTools_UserConfigButtonPalette" caption="配置" dropDown="true" menuStyle="false">
          <button refID="XIAOFUTools_SettingsButton" />
          <button refID="XIAOFUTools_AboutButton" />
        </buttonPalette>
      </palettes>
      <!-- ============================== 图库定义 ============================== -->
      <galleries>
        <!-- 添加预设图层图库 -->
        <gallery id="XIAOFUTools_PresetLayersGallery" caption="添加预设图层" className="XIAOFUTools.Features.General.PresetLayers.PresetLayersGallery" keytip="PL" itemsInRow="3" itemWidth="60" itemHeight="120" showItemCaption="true" showItemCaptionBelow="true" resizable="false" loadingMessage="加载中..." dropDownHeight="250" dropDownWidth="320" menuStyle="true" dataTemplateFile="Features\General\PresetLayers\PresetLayersGalleryTemplate.xaml" templateID="PresetLayerItemTemplate" smallImage="Assets\Images\PresetLayers_16.png" largeImage="Assets\Images\PresetLayers_32.png">
          <tooltip heading="添加预设图层">
            从预设图层库中选择并添加图层到地图
            <disabledText>当前状态不可用</disabledText></tooltip>
        </gallery>
      </galleries>
      <!-- ============================== 停靠窗格定义 ============================== -->
      <dockPanes>
        <!-- 批量添加数据停靠窗格 -->
        <dockPane id="XIAOFUTools_QuickAddDataDockPane" caption="快捷添加数据" className="XIAOFUTools.Features.General.QuickAddData.QuickAddDataDockPane" dock="group" dockWith="esri_core_projectDockPane"></dockPane>
