            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 批量修复几何按钮 -->
        <button id="XIAOFUTools_BatchGeometryRepairButton" caption="批量修复几何" className="XIAOFUTools.Features.DataManagement.BatchGeometryRepair.BatchGeometryRepairButton" loadOnClick="true" smallImage="Assets\Images\BatchGeometryRepair_16.png" largeImage="Assets\Images\BatchGeometryRepair_32.png">
          <tooltip heading="批量修复几何">
            批量修复选中图层的几何错误
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 查看面积按钮 -->
        <button id="XIAOFUTools_ViewAreaButton" caption="查看面积" className="XIAOFUTools.Features.Analysis.ViewArea.ViewAreaButton" loadOnClick="true" smallImage="Assets\Images\ViewArea_16.png" largeImage="Assets\Images\ViewArea_32.png">
          <tooltip heading="查看面积">
            查看当前选中要素的面积和长度信息
            <disabledText>当前状态不可用</disabledText></tooltip>
        </button>
        <!-- 历史影像按钮 -->
        <button id="XIAOFUTools_HistoricalImageryButton" caption="历史影像" className="XIAOFUTools.Features.General.HistoricalImagery.HistoricalImageryButton" loadOnClick="true" smallImage="Assets\Images\HistoricalImagery_16.png" largeImage="Assets\Images\HistoricalImagery_32.png">
