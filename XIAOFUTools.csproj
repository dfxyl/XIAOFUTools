  <Target Name="ValidateArcGISProInstall" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(ArcGISProInstallDir)' == ''" Text="未找到 ArcGIS Pro。请设置 ArcGISProInstallDir 环境变量或通过 /p:ArcGISProInstallDir=... 指定安装目录。" />
    <Error Condition="'$(ArcGISProInstallDir)' != '' and !Exists('$(ArcGISProInstallDir)\bin\ArcGIS.Core.dll')" Text="ArcGISProInstallDir 指向无效目录：$(ArcGISProInstallDir)" />
  </Target>
  <Import Project="D:\RUANJIAN\ArcGIS\Pro\bin\Esri.ProApp.SDK.Desktop.targets" Condition="'$(ArcGISProInstallDir)' != '' and Exists('$(ArcGISProInstallDir)\bin\Esri.ProApp.SDK.Desktop.targets') and !Exists('Esri.ArcGISPro.Extensions.targets')" />
