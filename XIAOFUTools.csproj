<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildProjectDirectory)\XIAOFUTools.local.props"
          Condition="Exists('$(MSBuildProjectDirectory)\XIAOFUTools.local.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>CA1416</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/xiaofuX1/XIAOFUTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ArcGISProInstallDir Condition="'$(ArcGISProInstallDir)' == '' and Exists('$(ProgramW6432)\ArcGIS\Pro\bin\ArcGIS.Core.dll')">$(ProgramW6432)\ArcGIS\Pro</ArcGISProInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="tmp\**" />
    <EmbeddedResource Remove="tests\**" />
    <EmbeddedResource Remove="tmp\**" />
    <None Remove="tests\**" />
    <None Remove="tmp\**" />
    <Page Remove="tests\**" />
    <Page Remove="tmp\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Config.daml" />
    <Content Include="Config.daml" />
    <None Remove="Assets\Images\*.png" />
    <Content Include="Assets\Images\*.png" Exclude="Assets\Images\Toolbox.png;Assets\Images\反馈表二维码.png;Assets\Images\新增工具收集清单二维码.png" />
    <Content Include="Assets\Images\GisToolPocket\*.png;Assets\Images\GisToolPocket\*.jpg" />
    <Resource Include="Assets\Images\GisToolPocket\*.png;Assets\Images\GisToolPocket\*.jpg" />
    <EmbeddedResource Include="Assets\Images\GisToolPocket\donation.jpg"
                      LogicalName="XIAOFUTools.Features.Custom.GisToolPocket.Images.donation.jpg" />
    <Resource Include="Assets\Images\Toolbox.png;Assets\Images\反馈表二维码.png;Assets\Images\新增工具收集清单二维码.png" />
    <None Update="Assets\Data\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Features\User\AIAssistant\UI\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="Features\General\PresetLayers\PresetLayersGalleryTemplate.xaml" />
    <None Include="Properties\launchSettings.json" />
  </ItemGroup>
  <ItemGroup>
